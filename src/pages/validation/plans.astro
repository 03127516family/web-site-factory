---
import LiveStatus from '../../components/validation/LiveStatus.astro';
const nextIntake = 'November';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Open Studio — Ways to Work Together</title>
  </head>
  <body>
    <header id="plans-header">
      <strong>OPEN STUDIO</strong>
      <a href="#questions">Questions</a>
    </header>
    <main id="plans-main">
      <section id="plans-intro">
        <p>SMALL TEAMS / CLEAR DECISIONS</p>
        <h1 id="editable-title">Choose the right starting point</h1>
        <p id="editable-copy">Each engagement begins with a concrete question and ends with a documented next step.</p>
      </section>
      <section id="plan-grid">
        <article id="plan-review" class="plan">
          <h2>Review</h2>
          <p class="price">One focused session</p>
          <p>Bring an existing proposal and the questions that remain unresolved.</p>
          <ul id="editable-list">
            <li>Preparation review</li>
            <li>Shared working session</li>
            <li>Written next steps</li>
          </ul>
          <a href="mailto:studio@example.com">Discuss a review</a>
        </article>
        <article id="plan-study" class="plan featured">
          <p class="label">For new directions</p>
          <h2>Study</h2>
          <p class="price">Two working weeks</p>
          <p id="plan-copy">Explore two directions through sketches, references, and a small prototype.</p>
          <ul>
            <li>Discovery conversation</li>
            <li>Two design directions</li>
            <li>Prototype and review</li>
          </ul>
          <a href="mailto:studio@example.com">Discuss a study</a>
        </article>
        <article id="plan-partner" class="plan">
          <h2>Partnership</h2>
          <p class="price">An ongoing conversation</p>
          <p>Keep decisions connected as a project moves from an idea into daily use.</p>
          <ul>
            <li>Regular working sessions</li>
            <li>Decision records</li>
            <li>Review of delivered work</li>
          </ul>
          <a href="mailto:studio@example.com">Discuss a partnership</a>
        </article>
      </section>
      <section id="questions">
        <h2>Before we begin</h2>
        <details id="plan-details" open>
          <summary>What should we prepare?</summary>
          <p id="detail-copy">Bring the current material, the constraints you know, and one decision you want to make.</p>
        </details>
        <details>
          <summary>Can the scope change?</summary>
          <p>Yes. Record the change and agree on the revised outcome before starting the next stage.</p>
        </details>
      </section>
      <section id="availability">
        <h2>Availability</h2>
        <p id="dynamic-line">Next intake: {nextIntake}</p>
        <LiveStatus />
        <p id="safe-neighbor">Write to the studio to discuss timing.</p>
      </section>
    </main>
    <footer id="plans-footer">Original sample content for editing validation. No services are sold on this page.</footer>
  </body>
</html>
<style is:global>
  * {
    box-sizing:border-box;
  }
  body {
    margin:0;
    color:#302c45;
    background:#faf9ff;
    font:17px/1.65 system-ui;
  }
  #plans-header {
    display:flex;
    justify-content:space-between;
    padding:24px 5vw;
    border-bottom:1px solid #ddd8ee;
  }
  a {
    color:inherit;
  }
  #plans-main {
    max-width:1180px;
    margin:auto;
    padding:48px 24px;
  }
  #plans-intro {
    max-width:760px;
    margin-bottom:44px;
  }
  h1 {
    font-size:clamp(34px,4vw,58px);
    line-height:1.1;
  }
  #plan-grid {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:24px;
    align-items:stretch;
  }
  .plan {
    display:flex;
    flex-direction:column;
    border:1px solid #d3cde5;
    border-radius:12px;
    padding:26px;
    background:#fff;
  }
  .plan h2 {
    margin:0;
  }
  .plan a {
    margin-top:auto;
    padding:12px 0;
  }
  .featured {
    background:#ebe5fc;
  }
  .price {
    font-weight:600;
  }
  .label {
    font-size:13px;
    text-transform:uppercase;
  }
  li {
    margin:8px 0;
  }
  #questions {
    max-width:780px;
    margin:60px 0;
  }
  details {
    border-top:1px solid #d3cde5;
    padding:20px 0;
  }
  summary {
    cursor:pointer;
    font-weight:600;
  }
  #availability {
    border-top:1px solid #d3cde5;
    padding:20px 0;
  }
  #plans-footer {
    padding:30px 5vw;
    background:#e9e5f3;
    font-size:14px;
  }
  @media(max-width:700px) {
    #plan-grid {
      grid-template-columns:1fr;
    }
    #plans-main {
      padding:28px 20px;
    }
  }
</style>
