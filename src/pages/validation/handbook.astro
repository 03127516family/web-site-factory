---
import ReadingFrame from '../../components/validation/ReadingFrame.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Field Guide — Observation Workflow</title>
  </head>
  <body>
    <header id="guide-header">FIELD GUIDE / Documentation</header>
    <div id="guide-layout">
      <nav id="guide-nav">
        <h2>On this page</h2>
        <a href="#preparation">Preparation</a>
        <a href="#schedule">Schedule</a>
        <a href="#notes">Recording notes</a>
      </nav>
      <main id="guide-main">
        <h1 id="editable-title">A repeatable observation workflow</h1>
        <p id="editable-copy">Use this guide to keep observations consistent across visits, while leaving room for unexpected findings.</p>
        <ReadingFrame class="guide-section">
          <h2 id="preparation">Before the visit</h2>
          <ul id="editable-list">
            <li>Confirm access and weather conditions.</li>
            <li>Bring a notebook, a map, and a charged camera.</li>
            <li>Agree on the questions the visit should answer.</li>
          </ul>
          <p id="slot-copy">Separate what you observed from what you inferred. Both are useful, but they should never become indistinguishable.</p>
        </ReadingFrame>
        <section id="schedule">
          <h2>Suggested schedule</h2>
          <div id="table-scroll">
            <table id="editable-table">
              <caption>Half-day observation plan</caption>
              <thead>
                <tr>
                  <th scope="col">Period</th>
                  <th scope="col">Activity</th>
                  <th scope="col">Record</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">09:00</th>
                  <td>Walk the complete route</td>
                  <td>Access and movement</td>
                </tr>
                <tr>
                  <th scope="row">10:30</th>
                  <td>Pause at three locations</td>
                  <td>Shade, sound, occupation</td>
                </tr>
                <tr>
                  <th scope="row">12:00</th>
                  <td>Review notes together</td>
                  <td>Questions for the next visit</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>
        <section id="notes">
          <h2>Recording notes</h2>
          <pre id="record-example">
            <code>Location: East bank
Time: 10:30
Observation: Three shaded seats occupied
Question: Does use change after lunch?</code>
          </pre>
          <details id="guide-details" open>
            <summary>What if conditions change?</summary>
            <p id="detail-copy">Record the change and repeat the observation later. An unexpected event is context, not a failed visit.</p>
          </details>
        </section>
        <figure id="lead-figure">
          <img id="editable-image" src="/validation/detail.svg" alt="Example of a measured frame" />
          <figcaption id="editable-caption">Use a simple diagram when a written description is not enough.</figcaption>
        </figure>
      </main>
    </div>
  </body>
</html>
<style is:global>
  * {
    box-sizing:border-box;
  }
  body {
    margin:0;
    color:#24354b;
    font:16px/1.7 system-ui;
    background:#fff;
  }
  #guide-header {
    padding:24px 5vw;
    background:#142b43;
    color:white;
  }
  #guide-layout {
    max-width:1200px;
    margin:auto;
    padding:40px 24px;
    display:grid;
    grid-template-columns:210px minmax(0,1fr);
    gap:50px;
  }
  #guide-main {
    min-width:0;
  }
  #guide-nav {
    position:sticky;
    top:30px;
    align-self:start;
  }
  #guide-nav a {
    display:block;
    margin:12px 0;
    color:#165a87;
  }
  h1 {
    font-size:38px;
    line-height:1.2;
  }
  h2 {
    font-size:24px;
  }
  section {
    margin:36px 0;
  }
  #table-scroll {
    overflow:auto;
  }
  table {
    width:100%;
    border-collapse:collapse;
  }
  th,td {
    border:1px solid #b7c7d4;
    padding:14px;
    text-align:left;
  }
  thead {
    background:#edf4f8;
  }
  caption {
    text-align:left;
    font-weight:600;
    padding-bottom:10px;
  }
  pre {
    padding:24px;
    background:#edf4f8;
    overflow:auto;
  }
  details {
    padding:20px;
    border:1px solid #b7c7d4;
  }
  summary {
    cursor:pointer;
    font-weight:600;
  }
  figure {
    margin:32px 0;
  }
  figure img {
    display:block;
    width:100%;
    max-height:280px;
    object-fit:cover;
  }
  figcaption {
    font-size:14px;
    padding:10px 0;
  }
  @media(max-width:700px) {
    #guide-layout {
      grid-template-columns:minmax(0,1fr);
      gap:20px;
      padding:20px;
    }
    #guide-nav {
      position:static;
    }
    h1 {
      font-size:30px;
    }
  }
</style>
