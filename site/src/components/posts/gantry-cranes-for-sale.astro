---
// post@1 — 本篇独立布局组件（T2 落定）：机械移植自旧 posts/gantry-cranes-for-sale.html；值 = JSON。
import { renderDoc } from '../../render-doc.mjs'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

const { j } = Astro.props
const repoFrag = name => readFileSync(join(process.cwd(), `../src/fragments/${name}.html`), 'utf8')
const WALK = { headingOffset: 1 }
---
<!-- ============ 蓝底标题横幅：面包屑 + 标题 ============ -->
<div class="toptitle">
	<div class="wrap">
		<div class="title">
			<div class="breadcrumb"><span class="unique_one" data-repeat="breadcrumb-trail" data-array="breadcrumb.trail" data-required>{j.breadcrumb.trail.map(t => <Fragment><span class="crumb"><a data-field="crumb.url" href={t.url}><span data-field="crumb.label">{t.label}</span></a><span class="symbol">&gt;</span></span>{' '}</Fragment>)}</span>{' '}<span class="current" data-field="breadcrumb.current" data-required>{j.breadcrumb.current}</span></div><!-- .breadcrumbs -->
			<h1 data-field="title" data-required>{j.title}</h1>
		</div>
	</div>
</div>

<!-- ============ 文章正文：左 TOC + 右正文（float 两栏） ============ -->
<div id="Topics">
	<div class="TopicsInfo wrap">
		<div class="craneinfo">

			<div id="rank-math-toc" class="wp-block-rank-math-toc-block">
				<p>目录</p>
				<nav><ul></ul></nav>
			</div>

			<!-- 导言 -->
			<div data-field="lead.body" data-edit="rich" set:html={renderDoc(j.lead.body, WALK)} />

			<!-- H2 市场概览 -->
			<h2 id="market-overview" class="wp-block-heading" data-field="body.h_overview" data-edit="text">{j.body.h_overview}</h2>
			<div data-field="overview_intro.body" data-edit="rich" set:html={renderDoc(j.overview_intro.body, WALK)} />

			<!-- 产品类型卡片网格（5 卡：3 列 + 2 列） -->
			<div class="card-grid wp-block-columns is-layout-flex wp-container-core-columns-is-layout-1 wp-block-columns-is-layout-flex">
				<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><figure class="wp-block-image size-full"><img data-field="body.card1_img" data-edit="image" src={j.body.card1_img} alt="单梁龙门起重机" width="280" height="190" /></figure><p class="card-name" data-field="body.card1_name" data-edit="text">{j.body.card1_name}</p></div>
				<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><figure class="wp-block-image size-full"><img data-field="body.card2_img" data-edit="image" src={j.body.card2_img} alt="双梁龙门起重机" width="280" height="190" /></figure><p class="card-name" data-field="body.card2_name" data-edit="text">{j.body.card2_name}</p></div>
				<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><figure class="wp-block-image size-full"><img data-field="body.card3_img" data-edit="image" src={j.body.card3_img} alt="半龙门起重机" width="280" height="190" /></figure><p class="card-name" data-field="body.card3_name" data-edit="text">{j.body.card3_name}</p></div>
			</div>
			<div class="card-grid wp-block-columns is-layout-flex wp-container-core-columns-is-layout-2 wp-block-columns-is-layout-flex">
				<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><figure class="wp-block-image size-full"><img data-field="body.card4_img" data-edit="image" src={j.body.card4_img} alt="便携式龙门起重机" width="280" height="190" /></figure><p class="card-name" data-field="body.card4_name" data-edit="text">{j.body.card4_name}</p></div>
				<div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><figure class="wp-block-image size-full"><img data-field="body.card5_img" data-edit="image" src={j.body.card5_img} alt="定制龙门起重机" width="280" height="190" /></figure><p class="card-name" data-field="body.card5_name" data-edit="text">{j.body.card5_name}</p></div>
			</div>

			<div data-field="overview_close.body" data-edit="rich" set:html={renderDoc(j.overview_close.body, WALK)} />

			<!-- H2 价格区间 -->
			<h2 id="price-range" class="wp-block-heading" data-field="body.h_price" data-edit="text">{j.body.h_price}</h2>

			<h3 id="single-girder-price" class="wp-block-heading" data-field="body.h_single" data-edit="text">{j.body.h_single}</h3>
			<figure class="wp-block-image size-full"><img data-field="body.img_single" data-edit="image" src={j.body.img_single} alt="单梁龙门起重机" width="880" height="495" /></figure>
			<div data-field="single.body" data-edit="rich" set:html={renderDoc(j.single.body, WALK)} />

			<h3 id="double-girder-price" class="wp-block-heading" data-field="body.h_double" data-edit="text">{j.body.h_double}</h3>
			<figure class="wp-block-image size-full"><img data-field="body.img_double" data-edit="image" src={j.body.img_double} alt="双梁龙门起重机" width="880" height="495" /></figure>
			<div data-field="double.body" data-edit="rich" set:html={renderDoc(j.double.body, WALK)} />

			<h3 id="semi-gantry-price" class="wp-block-heading" data-field="body.h_semi" data-edit="text">{j.body.h_semi}</h3>
			<figure class="wp-block-image size-full"><img data-field="body.img_semi" data-edit="image" src={j.body.img_semi} alt="半龙门起重机" width="880" height="495" /></figure>
			<div data-field="semi.body" data-edit="rich" set:html={renderDoc(j.semi.body, WALK)} />

			<h3 id="portable-price" class="wp-block-heading" data-field="body.h_portable" data-edit="text">{j.body.h_portable}</h3>
			<figure class="wp-block-image size-full"><img data-field="body.img_portable" data-edit="image" src={j.body.img_portable} alt="便携式龙门起重机" width="880" height="495" /></figure>
			<div data-field="portable.body" data-edit="rich" set:html={renderDoc(j.portable.body, WALK)} />

			<!-- H2 成本 -->
			<h2 id="cost" class="wp-block-heading" data-field="body.h_cost" data-edit="text">{j.body.h_cost}</h2>
			<div data-field="cost_intro.body" data-edit="rich" set:html={renderDoc(j.cost_intro.body, WALK)} />
			<figure class="wp-block-image size-full"><img data-field="body.img_cost" data-edit="image" src={j.body.img_cost} alt="龙门起重机成本因素" width="880" height="495" /></figure>

			<h3 id="cost-equipment" class="wp-block-heading" data-field="body.h_cost1" data-edit="text">{j.body.h_cost1}</h3>
			<div data-field="cost1.body" data-edit="rich" set:html={renderDoc(j.cost1.body, WALK)} />

			<h3 id="cost-special" class="wp-block-heading" data-field="body.h_cost2" data-edit="text">{j.body.h_cost2}</h3>
			<div data-field="cost2.body" data-edit="rich" set:html={renderDoc(j.cost2.body, WALK)} />

			<h3 id="cost-transport" class="wp-block-heading" data-field="body.h_cost3" data-edit="text">{j.body.h_cost3}</h3>
			<div data-field="cost3.body" data-edit="rich" set:html={renderDoc(j.cost3.body, WALK)} />

			<h3 id="cost-installation" class="wp-block-heading" data-field="body.h_cost4" data-edit="text">{j.body.h_cost4}</h3>
			<div data-field="cost4.body" data-edit="rich" set:html={renderDoc(j.cost4.body, WALK)} />

			<!-- H2 选购建议 -->
			<h2 id="buying-tips" class="wp-block-heading" data-field="body.h_tips" data-edit="text">{j.body.h_tips}</h2>
			<div data-field="tips.body" data-edit="rich" set:html={renderDoc(j.tips.body, WALK)} />

			<h3 id="conclusion" class="wp-block-heading" data-field="body.h_conclusion" data-edit="text">{j.body.h_conclusion}</h3>
			<div data-field="conclusion.body" data-edit="rich" set:html={renderDoc(j.conclusion.body, WALK)} />

		</div><!-- /.craneinfo -->
	</div><!-- /.TopicsInfo -->
</div><!-- /#Topics -->

<!-- ============ 询盘表单（复用动态块） ============ -->
<section data-template="inquiry-form@1" data-dynamic="inquiry-form" data-form-id="713" data-block-id="inquiry-form" class="post-inquiry wrap" id="from-single">
	<h3 data-field="inquiry_form.title">填写您的详细资料，我们将在24小时内给您答复!</h3>
	<Fragment set:html={repoFrag('inquiry-form')} />
</section>

<!-- ============ photoswipe 灯箱（chrome，逐字复用） ============ -->
<Fragment set:html={repoFrag('photoswipe')} />
