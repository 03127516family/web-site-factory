---
// post@1 — 5吨桥式起重机终极指南（T2 落定：每篇独立布局组件）
// 布局 = 本篇专属死骨架（移植自旧 posts/5-ton-overhead-crane.html）；值 = JSON
// （body.h_*/img_* 字段 + lead|types|…|conclusion 九棵正文树，walker 抄）。
// 守卫纪律（T9）：镜像 approved 投影删未审段——h2 与配对段体同守（j.body?.h_x && j.x，
// 哪个缺都整段不出，防 renderDoc 炸 + 防空 h2 进 TOC）；zh 源恒全，守卫对 zh 零影响。
import { renderDoc } from '@src/render/render.mjs'
import InquiryForm from '@src/components/shared/InquiryForm.astro'
import { readFileSync } from 'node:fs'
import { join } from 'node:path'

const { j } = Astro.props
const repoFrag = name => readFileSync(join(process.cwd(), `src/chrome/${name}.html`), 'utf8')
const WALK = { headingOffset: 1 }
---

<!-- ============ 蓝底标题横幅：面包屑 + 标题 ============ -->
<div class="toptitle">
	<div class="wrap">
		<div class="title">
			<div class="breadcrumb"><span class="unique_one" data-repeat="breadcrumb-trail" data-repeat-key="breadcrumb-trail" data-array="breadcrumb.trail" data-required>{j.breadcrumb.trail.map(t => <Fragment><span class="crumb" data-item-id={t.id}><a data-field="crumb.url" data-item-field="url" href={t.url}><span data-field="crumb.label" data-item-field="label">{t.label}</span></a><span class="symbol">&gt;</span></span>{' '}</Fragment>)}</span>{' '}<span class="current" data-field="breadcrumb.current" data-required>{j.breadcrumb.current}</span></div><!-- .breadcrumbs -->
			<h1 data-field="title" data-required>{j.title}</h1>
		</div>
	</div>
</div>

<!-- ============ 文章正文：左 TOC + 右正文（float 两栏） ============ -->
<div id="Topics">
	<div class="TopicsInfo wrap">
		<div class="craneinfo">

			<div id="rank-math-toc" class="wp-block-rank-math-toc-block">
				<p>目录</p>
				<nav><ul></ul></nav>
			</div>

			<!-- 导言 -->
			{j.lead && (
			<div data-field="lead.body" data-edit="rich" set:html={renderDoc(j.lead.body, WALK)} />
			)}

			<!-- H2 类型 -->
			{j.body?.h_types && j.types && (
			<h2 id="types" class="wp-block-heading" data-field="body.h_types" data-edit="text">{j.body.h_types}</h2>
			)}
			{j.body?.img_types && (<figure class="wp-block-image size-full"><img data-field="body.img_types" data-edit="image" src={j.body.img_types} alt="5吨桥式起重机类型总览" width="880" height="495" /></figure>)}
			{j.body?.h_types && j.types && (
			<div data-field="types.body" data-edit="rich" set:html={renderDoc(j.types.body, WALK)} />
			)}

			<!-- H2 应用行业 -->
			{j.body?.h_apps && j.apps && (
			<h2 id="applications" class="wp-block-heading" data-field="body.h_apps" data-edit="text">{j.body.h_apps}</h2>
			)}
			{j.body?.h_apps && j.apps && (
			<div data-field="apps.body" data-edit="rich" set:html={renderDoc(j.apps.body, WALK)} />
			)}

			<!-- H2 价格 -->
			{j.body?.h_price && j.price && (
			<h2 id="price" class="wp-block-heading" data-field="body.h_price" data-edit="text">{j.body.h_price}</h2>
			)}
			{j.body?.h_price && j.price && (
			<div data-field="price.body" data-edit="rich" set:html={renderDoc(j.price.body, WALK)} />
			)}

			<!-- H2 定制价格案例 -->
			{j.body?.h_price_custom && j.price_custom && (
			<h2 id="price-custom" class="wp-block-heading" data-field="body.h_price_custom" data-edit="text">{j.body.h_price_custom}</h2>
			)}
			{j.body?.h_price_custom && j.price_custom && (
			<div data-field="price_custom.body" data-edit="rich" set:html={renderDoc(j.price_custom.body, WALK)} />
			)}

			<!-- H2 影响因素 -->
			{j.body?.h_factors && j.factors && (
			<h2 id="factors" class="wp-block-heading" data-field="body.h_factors" data-edit="text">{j.body.h_factors}</h2>
			)}
			{j.body?.h_factors && j.factors && (
			<div data-field="factors.body" data-edit="rich" set:html={renderDoc(j.factors.body, WALK)} />
			)}

			<!-- H2 类型对比 -->
			{j.body?.h_compare && j.compare && (
			<h2 id="comparison" class="wp-block-heading" data-field="body.h_compare" data-edit="text">{j.body.h_compare}</h2>
			)}
			{j.body?.h_compare && j.compare && (
			<div data-field="compare.body" data-edit="rich" set:html={renderDoc(j.compare.body, WALK)} />
			)}

			<!-- H2 矿山案例 -->
			{j.body?.h_cases && j.cases && (
			<h2 id="cases" class="wp-block-heading" data-field="body.h_cases" data-edit="text">{j.body.h_cases}</h2>
			)}
			{j.body?.h_cases && j.cases && (
			<div data-field="cases.body" data-edit="rich" set:html={renderDoc(j.cases.body, WALK)} />
			)}

			<!-- H2 结论 -->
			{j.body?.h_conclusion && j.conclusion && (
			<h2 id="conclusion" class="wp-block-heading" data-field="body.h_conclusion" data-edit="text">{j.body.h_conclusion}</h2>
			)}
			{j.body?.h_conclusion && j.conclusion && (
			<div data-field="conclusion.body" data-edit="rich" set:html={renderDoc(j.conclusion.body, WALK)} />
			)}

		</div><!-- /.craneinfo -->
	</div><!-- /.TopicsInfo -->
</div><!-- /#Topics -->

<!-- ============ 询盘表单（共享组件） ============ -->
{j.inquiry_form && <InquiryForm title={j.inquiry_form.title} class="post-inquiry wrap" />}

<!-- ============ photoswipe 灯箱（chrome，逐字复用） ============ -->
<Fragment set:html={repoFrag('photoswipe')} />
