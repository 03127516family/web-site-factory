    },
    "6f044fe3a3c9": {
      "text": "10年以上的起重机出口经验",
      "translation": "Over 10 years of crane export experience",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8952859b5469": {
      "text": "起重机已销往120多个国家",
      "translation": "Cranes sold to more than 120 countries",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "6714e7c2805e": {
      "text": "一个由50多人组成的技术团队",
      "translation": "A technical team of over 50 people",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "aa6e098859f8": {
      "text": "3000多个不同行业的案例",
      "translation": "Over 3,000 cases across different industries",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "a21998cb41f9": {
      "text": "报价要求",
      "translation": "Request a Quote",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "110d15bf3e5b": {
      "text": "容量：高达16吨",
      "translation": "Lifting Capacity: up to 16 tons",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "ad142ca574f3": {
      "text": "臂长：高达16米",
      "translation": "Boom Length: Up to 16m",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "d250e13b95b6": {
      "text": "升降高度：高达12（地面到吊杆底部）",
      "translation": "Lifting Height: up to 12 (floor to boom bottom)",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "5b90bee57b0c": {
      "text": "工作职责。M3-M5",
      "translation": "Duty Class: M3-M5",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "f177cbe1c41f": {
      "text": "旋转角度：120-360°",
      "translation": "Rotation Angle: 120-360°",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "3e24e2d9b0c5": {
      "text": "工作电压：220V~690V，50-60Hz，3ph AC",
      "translation": "Power Supply: 220V~690V, 50-60Hz, 3ph AC",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "774c09bd5f18": {
      "text": "新参数请求",
      "translation": "Request New Parameters",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "e023d099fa1b": {
      "text": "新参数完全",
      "translation": "New Parameters Complete",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "bbcecb5e327b": {
      "text": "相关产品",
      "translation": "Related Products",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "bf21f17cbbd6": {
      "text": "FEM标准旋臂式起重机",
      "translation": "FEM Standard Jib Crane",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "b710c33e363b": {
      "text": "欧式旋臂吊结构独特，安全可靠，具有高效、节能、省时、灵活等特点。它特别适用于短距离、高强度的吊装场所。欧式旋臂吊广泛用于车间、仓库、码头等固定场所。工作等级一般为A4或A5。",
      "translation": "The European-style jib crane has a unique structure, safe and reliable, with high efficiency, energy saving, time saving, and flexibility. It is especially suitable for short-distance, high-intensity lifting places. European-style jib cranes are widely used in workshops, warehouses, docks, and other fixed places. The duty class is generally A4 or A5.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "48cbbce1f1c7": {
      "text": "FEM标准钢丝绳电动葫芦",
      "translation": "FEM Standard Wire Rope Electric Hoist",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:00.535Z"
    },
    "620c35673b46": {
      "text": "欧式钢丝绳电动葫芦的起升机构采用行星齿轮，结构紧凑，重量轻，安装在卷筒内，有效地缩小了葫芦的整体尺寸。欧式钢丝绳电动葫芦的设计最大程度地采用了模块化设计，各部件的通用程度高。",
      "translation": "The lifting mechanism of the European wire rope electric hoist uses a planetary gear drive - compact, lightweight, and mounted inside the drum, it effectively reduces the overall size of the hoist. The European wire rope electric hoist is designed for maximum modularity, with a high degree of part commonality.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:00.535Z"
    },
    "c150a890982d": {
      "text": "FEM标准电动环链升降机",
      "translation": "FEM Standard Electric Chain Hoist",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "d5690e5c9c36": {
      "text": "欧式环链电动葫芦结构紧凑，性能可靠。模块化设计使我们的产品可以灵活地组成不同的起重吨位、起重速度和工作等级系统。",
      "translation": "The European electric chain hoist is compact and reliable. Its modular design lets our products flexibly form systems with different lifting capacities, lifting speeds, and duty classifications.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:00.535Z"
    },
    "2329e045fe02": {
      "text": "FEM标准门式起重机",
      "translation": "FEM Standard Gantry Crane",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "66dbe3bbf6be": {
      "text": "欧式龙门吊采用欧洲设计标准和制造技术，达到了国际同类产品的先进水平，如高度低、重量轻、轮压小、直接驱动灵活、无级变速、免维护等。",
      "translation": "The European-style gantry crane adopts European design standards and manufacturing technology, reaching the advanced level of similar international products, such as low height, light weight, low wheel pressure, flexible direct drive, variable frequency speed control, and maintenance-free.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8ba232958f34": {
      "text": "导语",
      "translation": "Introduction",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "4e20480eda7d": {
      "text": "自由站立式JIB起重机通常用于较小的工作单元区域，用于重复性和独特的起重任务。",
      "translation": "Free-standing jib cranes are typically used in smaller work cell areas for repetitive and unique lifting tasks.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "e79027ab6e20": {
      "text": "旋臂式起重机的用途非常广泛，也可以与桥式起重机搭配使用，以最大限度地提高生产效率。",
      "translation": "Jib cranes are very versatile and can also be paired with overhead cranes to maximize production efficiency.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "1d35e79ca946": {
      "text": "工作范围是一个圆形区域，非常适用于短距离和密集排放的工作场所。",
      "translation": "The working range is a circular area, making it highly suitable for workplaces with short distances and dense material flow.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "b3f04aa85eeb": {
      "text": "具有较大的起重能力，可用于各种行业。",
      "translation": "It offers a substantial lifting capacity and can be used across various industries.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "c8ea1df47df4": {
      "text": "它结构轻巧，占用空间小，易于安装。",
      "translation": "Its lightweight structure occupies minimal space and is easy to install.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "153042ed9ee9": {
      "text": "概述",
      "translation": "Overview",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "de5755796393": {
      "text": "独立悬臂式起重机是由一个立柱、一个摆臂装置和一个电动葫芦组成。",
      "translation": "A freestanding jib crane consists of a column, a slewing arm, and an electric hoist.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "1f541dd5a541": {
      "text": "它在空间有限的车间里发挥了巨大作用。",
      "translation": "It proves highly effective in workshops with limited space.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "6d3f871ac451": {
      "text": "它占用的面积很小，可以覆盖整个工作区域。",
      "translation": "It occupies a very small footprint while covering the entire working area.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "f59af17ff762": {
      "text": "根据需要，它可以安装在地面或墙壁上，升降机构可以是电动或手动。",
      "translation": "Depending on requirements, it can be mounted on the floor or wall, and the lifting mechanism can be electric or manual.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "59fad9139749": {
      "text": "广泛应用于各种场所，如装卸码头、港口、船厂等，可与其他臂架式起重机配合使用，也可作为工厂流水线上的配套设备。",
      "translation": "Widely used in various locations such as loading docks, ports, and shipyards, it can be used in conjunction with other jib cranes or as supporting equipment on factory production lines.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "67bdcddf698b": {
      "text": "固定立柱式JIB起重机的安装和拆卸都非常简单，无需拆卸。",
      "translation": "The installation and dismantling of the fixed column jib crane are extremely simple, requiring no disassembly.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "5ea2e0cde2c8": {
      "text": "简介",
      "translation": "Introduction",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "0223deee613b": {
      "text": "独立悬臂式起重机的设计是为了不靠任何其他支撑而靠自己站在陆地上。",
      "translation": "The freestanding jib crane is designed to stand on its own without any other support.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "d240996ca24c": {
      "text": "它由一个可旋转的垂直立柱和一个水平负载支撑臂组成。",
      "translation": "It consists of a rotatable vertical column and a horizontal load-supporting arm.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "e4fc0b6c318b": {
      "text": "我们依靠的不是低悬臂式起重机的价格，而是独立悬臂式起重机的高质量来赢得实现我们公司的成长。",
      "translation": "We rely not on low jib crane prices but on the high quality of our freestanding jib cranes to achieve our company's growth.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "eff4332e92b4": {
      "text": "与壁挂式和壁行式旋臂吊相比，独立式旋臂吊可以达到更高的能力，更长的跨度和更大的旋转范围。",
      "translation": "Compared to wall-mounted and wall-traveling jib cranes, the freestanding jib crane can achieve higher capacities, longer spans, and a larger rotation range.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "ee4e2d6ea9b5": {
      "text": "由于结构上的优势，这种悬臂吊可以进行定制化的改造，以满足您的特殊应用要求。",
      "translation": "Due to its structural advantages, this jib crane can be customized to meet your specific application requirements.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "2df082043dc6": {
      "text": "唯一的安装限制是，独立悬臂吊所立足的土壤压力必须达到每平方英尺2500磅。",
      "translation": "The only installation constraint is that the soil pressure where the freestanding jib crane is placed must reach 2,500 pounds per square foot.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "4bbe706f8d37": {
      "text": "优势",
      "translation": "Advantages",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "51fd585547d8": {
      "text": "充分利用空间",
      "translation": "Maximizes Space Utilization",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "d2468b65700a": {
      "text": "易于安装",
      "translation": "Easy Installation",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "c9013486c572": {
      "text": "轻量级结构",
      "translation": "Lightweight Structure",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "d532025f28ee": {
      "text": "坚固耐用",
      "translation": "Robust and Durable",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "fed8c574203f": {
      "text": "安全性和可靠性",
      "translation": "Safety and Reliability",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "611e8d14d468": {
      "text": "低噪音",
      "translation": "Low Noise",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "c731c5c6a6d0": {
      "text": "基本参数",
      "translation": "Basic Parameters",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "0601eba0686e": {
      "text": "它是最近开发的一种中、小型起重设备，非常适用于短距离移动和工作场所的人群升降和运输。",
      "translation": "It is a recently developed medium and small lifting equipment, highly suitable for short-distance movement and lifting/transporting personnel in workplaces.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "83670e0f177a": {
      "text": "起重机旋转。",
      "translation": "Crane Rotation:",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "5084bfd1ebb5": {
      "text": "360度",
      "translation": "360 degrees",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "e76c6d6132dd": {
      "text": "旋转速度: 0.5 r/min",
      "translation": "Rotation Speed: 0.5 r/min",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "9ca30f932134": {
      "text": "安全工作负荷：高达16吨",
      "translation": "Safe Working Load: up to 16 tons",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "b39ea5d70a15": {
      "text": "提升高度：最高可达12（地面到吊杆底部）",
      "translation": "Lifting Height: up to 12 m (from floor to bottom of jib)",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "aecd66d243ca": {
      "text": "工作温度：-20~+40℃",
      "translation": "Working Temperature: -20~+40℃",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "67b112e5d7a1": {
      "text": "行走速度：20或30米/分钟",
      "translation": "Travel Speed: 20 or 30 m/min",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8a1bb4ec9f23": {
      "text": "控制模式：吊式手柄、遥控器和座舱",
      "translation": "Control Mode: Pendant Control, Remote Control, and Cabin",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "bfe4693a4012": {
      "text": "应用：广泛应用于各种行业",
      "translation": "Application: Widely used in various industries",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "d1b547d0abeb": {
      "text": "电源。",
      "translation": "Power Supply.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "62d665aaf3d8": {
      "text": "AC 380V, 50HZ, 3P",
      "translation": "AC 380V, 50HZ, 3P",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8ab797a18fc1": {
      "text": "注：用户也可以选择双速、单速环链和钢丝绳葫芦。",
      "translation": "Note: Users can also choose dual-speed, single-speed chain hoists and wire-rope hoists.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "cb50953b9cd6": {
      "text": "最大的通用性",
      "translation": "Maximum Versatility",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "95a39c0386d7": {
      "text": "它是最通用的起重机之一。",
      "translation": "It is one of the most versatile cranes.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "1203fc2a3284": {
      "text": "独立悬臂式起重机几乎可以安装在任何地方，无论是室内还是室外，如装卸码头、港口、船厂等。",
      "translation": "The free-standing jib crane can be installed almost anywhere, indoors or outdoors, such as loading docks, ports, shipyards, etc.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "de8968da2ee0": {
      "text": "它还可以与其他旋臂起重机一起工作，或作为工厂装配线的补充。",
      "translation": "It can also work with other jib cranes or serve as a supplement to factory assembly lines.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "4c5d48ee4979": {
      "text": "独立式悬臂吊的安装和搬迁非常简单，无需拆卸。",
      "translation": "Installation and relocation of the free-standing jib crane are very simple, without disassembly.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "851a5e6832e1": {
      "text": "操作简便",
      "translation": "Easy Operation",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "62b1455f925e": {
      "text": "我厂生产的起重机可以让操作者精确、有效、迅速地控制运动。",
      "translation": "The cranes produced by our factory allow operators to control movements precisely, effectively, and quickly.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "998246760562": {
      "text": "凭借先进的技术，我们可以使旋臂吊的运动非常简单和准确。",
      "translation": "With advanced technology, we can make the movements of the jib crane very simple and accurate.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "076c8f59dc17": {
      "text": "因此，无意的运动将被减少到最小。",
      "translation": "Therefore, unintentional movements will be minimized.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "31c22e6715a4": {
      "text": "反过来，对您的工厂、设备甚至人员的损害也会大大减少。",
      "translation": "In turn, damage to your plant, equipment, and even personnel will be greatly reduced.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "4ff577d31473": {
      "text": "起重机的工作寿命可以得到更多的保证，并将被延长。",
      "translation": "The working life of the crane can be better guaranteed and extended.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8e662a5618f9": {
      "text": "安全",
      "translation": "Safety",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "0c8b74d533e4": {
      "text": "我们始终把安全放在心上！！！",
      "translation": "We always put safety in mind!!!",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "45a3767792d7": {
      "text": "我们采用了紧急停止系统来加强安全。",
      "translation": "We have adopted an emergency stop system to enhance safety.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "25d620d5eb71": {
      "text": "我们采用紧急制动系统来加强安全。",
      "translation": "We adopt an emergency braking system to enhance safety.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8797c384dcf6": {
      "text": "当操作人员遇到一些紧急情况时，紧急制动系统将启动，以保护相关宝物。",
      "translation": "When operators encounter some emergency situations, the emergency braking system will be activated to protect the relevant assets.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "975e8d5bdc88": {
      "text": "我们工厂的每一件产品在传送到你的工作场所之前都经过了良好的测试。",
      "translation": "Every product from our factory is well tested before being delivered to your workplace.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "8c1a265a09d6": {
      "text": "如果你不能独立完成安装，我们有经验的工人将不会离开你的工作场所，直到起重机被检查为100%的保证。",
      "translation": "If you cannot complete the installation independently, our experienced workers will not leave your workplace until the crane is inspected and guaranteed 100%.",
      "status": "approved",
      "origin": "human",
      "updatedAt": "2026-08-15T08:44:34.947Z"
    },
    "338d0631017b": {
      "text": "多点悬挂式起重机：适用于大跨度工业车间 - DGCRANE",
      "translation": "Multi-point Suspension Crane: For Large-span Industrial Workshops - DGCRANE",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "b64371fdbd94": {
      "text": "多点悬挂式起重机专为大跨度工业车间和仓库（如飞机制造与维修厂）设计，通过多个悬挂点分散载荷，起重 3-40 吨，最大跨度可达 80 米。",
      "translation": "The multi-point suspension crane is specifically designed for large-span industrial workshops and warehouses (such as aircraft manufacturing and maintenance plants). It distributes the load through multiple suspension points, with a lifting capacity of 3-40 tons and a maximum span of up to 80 meters.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "48ff19d40500": {
      "text": "多点悬挂式起重机",
      "translation": "Multi-Point Suspension Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "c5517b71c883": {
      "text": "起重能力：3-40吨",
      "translation": "Lifting Capacity: 3-40 tons",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "38df6543563a": {
      "text": "悬挂点数：3、4、5、6、7、8",
      "translation": "Number of Suspension Points: 3, 4, 5, 6, 7, 8",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "d73b96828d18": {
      "text": "总跨度：最大可达 80 米",
      "translation": "Total Span: Up to 80 meters",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "d8b9dd0819df": {
      "text": "提升高度：3-30米",
      "translation": "Lifting Height: 3-30 meters",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "a4900bc1f6f1": {
      "text": "工作等级：A3–A5",
      "translation": "Duty Class: A3–A5",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "aaff00017efa": {
      "text": "工作站桥式起重机",
      "translation": "Workstation Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "c9d341444834": {
      "text": "工作站桥式起重机的起重量为0.125t-2t，应用范围很广。我们公司的工作站桥式起重机最大的优点是可以很容易地进行扩展，随时适应新的要求，可以与您的企业共同发展。",
      "translation": "The workstation Overhead Crane has a lifting capacity of 0.125t-2t and a wide range of applications. The biggest advantage of our company's workstation Overhead Crane is that it can be easily expanded to adapt to new requirements at any time, and can grow together with your business.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "d12a38f6b708": {
      "text": "航空业桥式起重机：简化飞机组装、维护和维修",
      "translation": "Aviation Industry Overhead Crane: Streamlining Aircraft Assembly, Maintenance, and Repair",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "119f66e38663": {
      "text": "单梁桥式起重机",
      "translation": "Single Girder Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "dd50d426cf60": {
      "text": "无论您是在进行采购计划，还是正在确定厂房起重设备的定制方案，如果起重能力要求在20吨及以下，单梁桥式起重机具有结构简单、方案灵活、拆装运输方便等优点可以是您的第二选择。",
      "translation": "Whether you are making a procurement plan or determining a customized solution for plant lifting equipment, if the lifting capacity requirement is 20 tons or less, the Single Girder Overhead Crane, with its simple structure, flexible solutions, and convenient disassembly, assembly, and transportation, can be your second choice.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "2b1b311f7aad": {
      "text": "单轨桥式起重机",
      "translation": "Monorail Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "ce278019368f": {
      "text": "单轨吊是一种替代传统起重机和传送带的起重机。这些起重机大多用于在有限的区域内重新安置材料或产品。这种场所可以是工厂或整个工作站。单轨吊的设计很简单，可以与建筑物的结构兼容，不需要做大的改动。",
      "translation": "A monorail crane is a type of crane that serves as an alternative to traditional cranes and conveyors. These cranes are mostly used to relocate materials or products within a limited area. Such a place can be a factory or an entire workstation. The design of the monorail crane is simple and can be compatible with the building structure without major modifications.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "300d33725460": {
      "text": "多点悬挂式起重机是一种专为满足大跨度工业车间和仓库（例如飞机制造厂和飞机维修厂）需求而设计的专用悬挂式起重机。",
      "translation": "The multi-point suspension crane is a specialized suspended crane designed to meet the needs of large-span industrial workshops and warehouses (such as aircraft manufacturing plants and aircraft maintenance plants).",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "178093590748": {
      "text": "通过多个悬挂点分散载荷，该起重机可降低起重机重量对建筑物屋顶结构的影响，从而降低建筑物高度，并有助于显著降低工厂建设成本。",
      "translation": "By distributing the load through multiple suspension points, this crane reduces the impact of the crane's weight on the building's roof structure, thereby lowering the building height and helping to significantly reduce factory construction costs.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "c99e83235e5b": {
      "text": "功能和亮点",
      "translation": "Features and Highlights",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "458ed2916954": {
      "text": "多点悬挂设计使该起重机适用于大跨度车间，在提供宽广作业范围的同时，有效减小结构尺寸，最大限度地减少净空占用，并提高有效起升高度。",
      "translation": "The multi-point suspension design makes this crane suitable for large-span workshops, providing a wide working range while effectively reducing structural dimensions, minimizing headroom occupation, and increasing the effective lifting height.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "3b5fefb7a077": {
      "text": "轻型起重机结构显著降低了建筑屋顶和钢结构框架的荷载要求。",
      "translation": "The lightweight crane structure significantly reduces the load requirements on the building roof and steel structure frame.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "54b1b5b9c362": {
      "text": "多跨距之间的铰接连接可有效防止车轮卸载和单个悬架点上的载荷过度集中。",
      "translation": "The articulated connections between multiple spans effectively prevent wheel unloading and excessive load concentration on individual suspension points.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "8067c4449afc": {
      "text": "起重机轮组件可适配H型钢或I型钢轨道，灵活满足不同的建筑结构和客户需求。",
      "translation": "The crane wheel assembly can be adapted to H-beam or I-beam rails, flexibly meeting different building structures and customer needs.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "1bd970610e5e": {
      "text": "用于台车供电的紧凑型电缆串管系统可缩小左右两端的限位，从而提高车间空间的整体利用率。",
      "translation": "The compact cable festoon system for trolley power supply reduces the limit switches on the left and right ends, thereby improving the overall utilization of workshop space.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "5d743031662f": {
      "text": "配备三合一驱动单元和变频驱动（VFD）控制，运行平稳可靠，调速范围宽广，定位精度高。",
      "translation": "Equipped with a three-in-one drive unit and variable frequency drive (VFD) control, it operates smoothly and reliably, with a wide speed adjustment range and high positioning accuracy.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "779caf13a519": {
      "text": "同步控制技术确保多个驱动单元的协调运行，有效防止轨道歪斜。",
      "translation": "Synchronous control technology ensures coordinated operation of multiple drive units, effectively preventing rail skewing.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "e3f5678bd416": {
      "text": "PLC控制系统可实现多台起重机的协同操作，扩大作业范围。",
      "translation": "The PLC control system enables collaborative operation of multiple cranes, expanding the working range.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "acbf5399ac81": {
      "text": "采用耐磨工程塑料制成的行走轮有助于防止车轮和起重机轨道磨损。",
      "translation": "The traveling wheels made of wear-resistant engineering plastic help prevent wear on the wheels and crane rails.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "dcd75b1222dc": {
      "text": "高强度、无油钢丝绳和T级高强度吊钩提高了整体安全性和可靠性。",
      "translation": "High-strength, oil-free wire ropes and T-grade high-strength hooks improve overall safety and reliability.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "00dd95e089c6": {
      "text": "采用高性能聚合物复合材料制成的绳索导向器具有磨损小、强度高、韧性好等优点。",
      "translation": "The rope guide made of high-performance polymer composite material has the advantages of low wear, high strength, and good toughness.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "922b87edab13": {
      "text": "电子防摇摆功能提高了起重稳定性和作业效率。",
      "translation": "The electronic anti-sway function improves lifting stability and operational efficiency.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "b04d064d1ada": {
      "text": "多点悬挂式起重机与悬挂式起重机的比较",
      "translation": "Comparison of Multi-Point Suspension Crane and Suspended Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "326b9f622fb3": {
      "text": "支撑布置：沿跑道梁布置多个悬挂点，以均匀分散载荷。",
      "translation": "Support arrangement: Multiple suspension points are arranged along the runway beam to evenly distribute the load.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "25b07393f8b5": {
      "text": "提升稳定性：多点悬挂确保运行平稳；配备变频驱动（VFD）控制和防摇摆系统，实现高精度定位。",
      "translation": "Enhanced stability: Multi-point suspension ensures smooth operation; equipped with Variable Frequency Drive (VFD) control and anti-sway system for high-precision positioning.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "d3d85924b55c": {
      "text": "跨度能力：通过增加悬挂点数量可以实现大跨度，最大跨度可达 80 米。",
      "translation": "Span capability: Large spans can be achieved by increasing the number of suspension points, with a maximum span of up to 80 meters.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "877b101e6a7d": {
      "text": "应用领域：大跨度、高要求设施，例如飞机维修机库和飞机制造厂。",
      "translation": "Applications: Large-span, high-demand facilities such as aircraft maintenance hangars and aircraft manufacturing plants.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "f587e5d56154": {
      "text": "悬臂式起重机",
      "translation": "Jib Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "18c46d000856": {
      "text": "支撑结构：两个悬挂点，直接悬挂在跑道轨道下方，无需立柱。",
      "translation": "Support structure: Two suspension points, directly suspended below the runway track, requiring no columns.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "10f88308aca2": {
      "text": "起升稳定性：适用于标准车间的一般物料搬运需求。",
      "translation": "Lifting stability: Suitable for general material handling needs in standard workshops.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "629b941ef372": {
      "text": "跨度范围：常用于中小跨度建筑，典型跨度约为 3–22.5 米。",
      "translation": "Span range: Commonly used in small to medium-span buildings, with typical spans of approximately 3–22.5 meters.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "5d2fc8e499f1": {
      "text": "应用领域：机械加工车间、机器装配区、设备维修设施和仓库中的一般物料搬运。",
      "translation": "Applications: General material handling in machine shops, machine assembly areas, equipment maintenance facilities, and warehouses.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "543b19466eb3": {
      "text": "多点悬挂式起重机案例",
      "translation": "Multi-Point Suspension Crane Case Studies",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "20fae869207d": {
      "text": "用于飞机维修车间的多点悬挂式起重机",
      "translation": "Multi-Point Suspension Crane for Aircraft Maintenance Workshop",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "6795e79c5b82": {
      "text": "在飞机维修车间，多点悬挂式起重机用于吊装、搬运和定位大型飞机部件，例如机身段、机翼、尾翼组件、发动机和起落架。",
      "translation": "In an aircraft maintenance workshop, a multi-point suspension crane is used for lifting, transporting, and positioning large aircraft components such as fuselage sections, wings, tail assemblies, engines, and landing gear.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "176c334eedec": {
      "text": "由于飞机部件尺寸庞大、形状复杂，且在吊装过程中对平衡性、同步性和精确定位的要求极高，这种起重机采用多个支撑点来分散负载，实现同步吊装/移动。",
      "translation": "Due to the large size, complex shapes, and extremely high requirements for balance, synchronization, and precise positioning during lifting, this crane uses multiple support points to distribute the load and achieve synchronized lifting/moving.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "caa1d5fe8e29": {
      "text": "这使得它能够平稳、精确地将大型、不规则形状的部件从一个工作站移动到另一个工作站，并将发动机、机翼和其他部件吊装到维修平台上，同时最大限度地减少部件的摆动。",
      "translation": "This enables it to smoothly and precisely move large, irregularly shaped components from one workstation to another, and lift engines, wings, and other parts onto maintenance platforms while minimizing component sway.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "9cb274012194": {
      "text": "对于跨度大、内部空间宽敞的飞机库，架空起重机可以充分利用上层空间而不占用地面面积，从而提高空间利用率和维护效率。",
      "translation": "For aircraft hangars with large spans and spacious interiors, overhead cranes can fully utilize the upper space without occupying floor area, thereby improving space utilization and maintenance efficiency.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "9f500d421a22": {
      "text": "用于大型橡胶制造厂的多点悬挂式起重机",
      "translation": "Multi-Point Suspension Crane for a Large Rubber Manufacturing Plant",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "32f72184068a": {
      "text": "该项目实施于一家大跨度橡胶生产车间。",
      "translation": "This project was implemented in a large-span rubber production workshop.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "ab34ae4f3b2b": {
      "text": "该建筑为既有结构，结构状况复杂，部分钢构件存在变形。",
      "translation": "The building was an existing structure with complex structural conditions, and some steel components had deformation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "b9e40a68b532": {
      "text": "此外，生产过程中需要吊装和搬运超长物料，对起重设备的负载平衡和运行稳定性提出了很高的要求。",
      "translation": "In addition, the production process required lifting and transporting extra-long materials, imposing high demands on load balance and operational stability of the lifting equipment.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "3acfdc62a84d": {
      "text": "鉴于此，项目采用了多点悬挂式起重机方案，以适应大跨度结构并提升整体运行安全性。",
      "translation": "Given this, the project adopted a multi-point suspension crane solution to accommodate the large-span structure and enhance overall operational safety.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "a45e249be730": {
      "text": "该项目配备两台多点悬挂式起重机，每台起重机均采用60米主梁和七点悬挂设计，以有效分散载荷。",
      "translation": "The project is equipped with two multi-point suspension cranes, each featuring a 60-meter Main Girder and a seven-point suspension design to effectively distribute the load.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "1b6e2ba8f2ca": {
      "text": "此外，还配备了用于吊装超长物料的专用起重装置，以满足生产过程中特定的物料搬运需求。",
      "translation": "Additionally, specialized lifting devices for handling extra-long materials were provided to meet specific material handling needs during production.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "379d99437817": {
      "text": "为解决现有钢结构变形等不利安装条件，安装前进行了全面的现场评估。",
      "translation": "To address adverse installation conditions such as deformation of existing steel structures, a comprehensive on-site assessment was conducted before installation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "f386c29051a0": {
      "text": "随后对支撑钢结构采取了纠正措施，确保起重机的可靠安装和长期稳定运行。",
      "translation": "Subsequently, corrective measures were taken on the supporting steel structure to ensure reliable installation and long-term stable operation of the crane.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:37:21.336Z"
    },
    "f05a1a45ab96": {
