    },
    "fb47bf17bf23": {
      "text": "传统风格的桥式起重机",
      "translation": "Traditional-style Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "cfa2393bbbe8": {
      "text": "欧洲型桥式起重机",
      "translation": "European-style Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "7ddb5db48f26": {
      "text": "结构和功能",
      "translation": "Structure and Function",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "64ef687a167f": {
      "text": "简单",
      "translation": "Simple",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "81cb3ace2c8c": {
      "text": "复杂的和多功能的",
      "translation": "Complex and Multi-functional",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "c32d7c9067b0": {
      "text": "成本效益高得多",
      "translation": "Much more cost-effective",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "807b7109373a": {
      "text": "昂贵的",
      "translation": "Expensive",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "dc1512afa4d6": {
      "text": "起重机净重",
      "translation": "Crane Net Weight",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "e7556e89cddc": {
      "text": "更重的能源成本和更高的建筑成本。",
      "translation": "Heavier energy costs and higher construction costs.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "62c2620412a1": {
      "text": "更轻的钢结构和更有效的能源成本更有效的建筑成本",
      "translation": "Lighter steel structure and more efficient energy costs, more efficient construction costs",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "a038a6456c54": {
      "text": "适应能力",
      "translation": "Adaptability",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "472fd9be18db": {
      "text": "在服务工作条件和不适当的操作中更加强大",
      "translation": "More robust in harsh working conditions and improper operation",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "c37c5538cc48": {
      "text": "稳定和舒适，但需要有适当的工作条件和适当的操作。",
      "translation": "Stable and comfortable, but requires proper working conditions and proper operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "ab4207d0a36e": {
      "text": "哪个更好",
      "translation": "Which is Better",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "f34fcdf4693b": {
      "text": "一般来说，欧洲型桥式起重机更先进、更好。",
      "translation": "Generally speaking, European-style Overhead Crane is more advanced and better.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "5560f17a700a": {
      "text": "而在工作条件、操作条件和价格方面，我知道合适的才是最好的。",
      "translation": "However, in terms of working conditions, operating conditions, and price, I know that the right one is the best.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "2a75dab17461": {
      "text": "在DGCRANE，我们很荣幸为您提供合适的起重机，我们有不同类型的桥式起重机，并有灵活的销售计划。",
      "translation": "At DGCRANE, we are honored to provide you with the right crane. We have different types of Overhead Cranes and flexible sales plans.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "e3053e284fc2": {
      "text": "组成部分",
      "translation": "Components",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "008bd88ede92": {
      "text": "主梁为焊接的箱形结构，下翼缘板为提升机运行轨道。",
      "translation": "The main girder is a welded box structure with the lower flange plate serving as the runway for the hoist.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "a88d5515217c": {
      "text": "主梁严格按照工艺流程进行生产。",
      "translation": "The main girder is manufactured strictly in accordance with the process flow.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "bcceb0dfaef2": {
      "text": "焊接采用全自动CO2保护焊生产线，焊接变形小，焊缝强度高，残余应力低。",
      "translation": "Welding adopts a fully automatic CO2 shielded welding production line, resulting in minimal welding deformation, high weld strength, and low residual stress.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "088f1ff808e9": {
      "text": "焊缝按国家标准GB3323进行检验。",
      "translation": "Welds are inspected according to national standard GB3323.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "a25a0736b286": {
      "text": "它具有较好的强度、刚度和稳定性",
      "translation": "It possesses good strength, rigidity, and stability.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "1a9d63fe0793": {
      "text": "起重机端头车采用矩形管整体端头梁结构，避免焊接造成的变形。",
      "translation": "The crane end carriage adopts a rectangular tube integral end beam structure to avoid deformation caused by welding.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "67aab579f553": {
      "text": "采用大型落地镗床一次加工成型，保证车轮的两个挠度值在公差范围内。",
      "translation": "It is machined in one pass using a large floor-type boring machine, ensuring that the two deflection values of the wheels are within tolerance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "60563e2e7c40": {
      "text": "起重机端梁的改进设计，降低了垂直刚度，增加了水平刚度，可以克服起重机车轮三个轮子接触地面的现象，大大提高了车轮的寿命。",
      "translation": "The improved design of the crane end carriage reduces vertical rigidity and increases horizontal rigidity, which can overcome the phenomenon of three wheels contacting the ground, greatly extending wheel life.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "485800aa2b80": {
      "text": "安装车轮的端梁结构融合了国际先进技术，采用整体镗孔结构，安装精度更高。",
      "translation": "The end carriage structure for mounting wheels integrates international advanced technology and adopts an integral boring structure for higher installation accuracy.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "17603b90c5ef": {
      "text": "提升机构采用欧式葫芦或欧式小车。",
      "translation": "The hoisting mechanism adopts a European-style hoist or European-style trolley.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "2cf70a7262c6": {
      "text": "葫芦提升机构采用行星齿轮，结构紧凑，重量轻，安装在卷筒内，有效地缩小了电动葫芦的体积。",
      "translation": "The hoist lifting mechanism uses planetary gears, which are compact and lightweight, installed inside the drum, effectively reducing the size of the electric hoist.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "9dfa1cdfa8a0": {
      "text": "其设计最大程度地采用了模块化设计，零部件通用性强。",
      "translation": "Its design maximizes the use of modular design, with strong part interchangeability.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "740887b3d02e": {
      "text": "设计标准采用欧洲FEM标准，提升速度、运行速度等参数的选择更加人性化。",
      "translation": "The design standard adopts the European FEM standard, and the selection of parameters such as lifting speed and travel speed is more user-friendly.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "eda5564afbcf": {
      "text": "设计速度慢，定位准确，适合安装和维修；设计速度快，使提升机构的效率更高，更方便。",
      "translation": "Low design speed ensures accurate positioning, suitable for installation and maintenance; high design speed makes the hoisting mechanism more efficient and convenient.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "358ac5d5fe4c": {
      "text": "大车运行机构采用“三合一”驱动齿轮箱，分别驱动两侧端梁；电动机采用大车专用制动电动机，采用螺栓连接。",
      "translation": "The crane travel mechanism adopts a \"three-in-one\" drive gearbox, driving the end carriages on both sides separately; the motor is a dedicated brake motor for the crane, connected by bolts.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "8bbc41e2a5ee": {
      "text": "此驱动型式具有传动精度高、重量轻、密封性好、噪音低、寿命长、免维护等优点。",
      "translation": "This drive type offers advantages such as high transmission accuracy, light weight, good sealing, low noise, long life, and maintenance-free operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "fbb9e65495aa": {
      "text": "欧式起重机电压按客户当地工业电压确定，电气系统按电压制造。",
      "translation": "The voltage of the European-style crane is determined by the local industrial voltage of the customer, and the electrical system is manufactured accordingly.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "ddfedac72c55": {
      "text": "装有横叉旋转限位开关，在起重机缓冲器与轨道端块相撞前，切断横移电机及长行走电机电源。",
      "translation": "Equipped with a rotation limit switch for the cross fork, which cuts off the Power Supply to the cross travel motor and long travel motor before the crane buffer collides with the rail end stop.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "b4858d90c7dc": {
      "text": "装有超载限制器。",
      "translation": "Equipped with an overload limiter.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "b7ff2dfeb844": {
      "text": "当钢丝绳张力大于额定值90%时，超载保护装置报警。",
      "translation": "When the wire rope tension exceeds 90% of the rated value, the overload protection device alarms.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "518b6dc58ade": {
      "text": "当钢丝绳张力大于额定值110%时，超载保护装置自动切断起升电路。",
      "translation": "When the wire rope tension exceeds 110% of the rated value, the overload protection device automatically cuts off the lifting circuit.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "b4f6a20dc2ba": {
      "text": "小车电源采用异型钢悬挂配扁平电缆。",
      "translation": "The trolley power supply uses a special-shaped steel suspension with flat cable.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "c259bf1d4969": {
      "text": "操作面板、遥控、驾驶室操控。",
      "translation": "Operation panel, remote control, and cab operation. The crane can also be equipped with two sets of operation devices, namely: ground + remote control or cab + remote control.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "53c88d945a9a": {
      "text": "起重机也可配备两套操作装置，即：地面+遥控或驾驶室+遥控。",
      "translation": "The crane can also be equipped with two sets of operating devices: ground + remote control or cab + remote control.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "ee6f7862a612": {
      "text": "但出于安全问题，两种操作方式只能切换，不能同时使用。",
      "translation": "However, for safety reasons, the two operating modes can only be switched, not used simultaneously.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "e56140fce7c8": {
      "text": "起重机行走和小车横移机构一般在两端装有在位限位开关和限位开关",
      "translation": "The crane travel and trolley traverse mechanisms are generally equipped with positioning limit switches and limit switches at both ends.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "c873add4f49f": {
      "text": "防腐、防尘和密封措施",
      "translation": "Anti-corrosion, dust-proof, and sealing measures",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "0bdcc386362e": {
      "text": "适用于不同工作条件的起重机类型",
      "translation": "Crane Types for Different Working Conditions",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "22b1efeec478": {
      "text": "可靠性、高效、操作简便、安全",
      "translation": "Reliability, high efficiency, easy operation, and safety",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "d536f4568c55": {
      "text": "采购和维护成本低",
      "translation": "Low procurement and maintenance costs",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "57585b6dc873": {
      "text": "通常，HD欧式单梁桥式起重机的最大起重能力为12.5吨。",
      "translation": "Typically, the maximum Lifting Capacity of the HD European-style Single Girder Overhead Crane is 12.5 tons.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "872e44b2eb5c": {
      "text": "当容量大于12.5吨时，建议客户选择NLH欧式双梁桥式起重机。",
      "translation": "When the lifting capacity exceeds 12.5 tons, customers are advised to choose the NLH European-style Double Girder Overhead Crane.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "1b0a8acef5bc": {
      "text": "外观漂亮，结构轻巧",
      "translation": "Attractive appearance and lightweight structure",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "9ac407a5da5d": {
      "text": "环境友好，无声无息",
      "translation": "Environmentally friendly and quiet operation",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "44060dea5265": {
      "text": "技术优势：双速智能变频",
      "translation": "Technical advantages: dual-speed intelligent variable frequency",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "8d46f6adcc63": {
      "text": "稳定的提升",
      "translation": "Stable lifting",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:11.277Z"
    },
    "3348f48b6be3": {
      "text": "单梁桥式起重机 - DGCRANE",
      "translation": "Single Girder Overhead Crane - DGCRANE",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.012Z"
    },
    "f0767d0af3ef": {
      "text": "单梁桥式起重机制造商与出口商，适用于高速产线，10 年以上出口经验，销往 120 多个国家。",
      "translation": "Single Girder Overhead Crane manufacturer and exporter, suitable for high-speed production lines, with over 10 years of export experience, sold to more than 120 countries.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.012Z"
    },
    "a07e7686ff9a": {
      "text": "单梁桥式起重机是根据GB3811-2008和JB/T1306-2008标准设计的，并配有电动葫芦。它广泛应用于机械加工、装配、修理、仓库等工作场所。它是现代工业企业实现生产过程机械化、自动化，减少繁重的手工劳动，提高劳动生产率的重要工具和设备。",
      "translation": "The Single Girder Overhead Crane is designed according to GB3811-2008 and JB/T1306-2008 standards, and is equipped with an Electric Hoist. It is widely used in workplaces such as machining, assembly, repair, and warehouses. It is an important tool and equipment for modern industrial enterprises to realize mechanization and automation of production processes, reduce heavy manual labor, and improve labor productivity.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "9b040337b08d": {
      "text": "容量：1-20吨",
      "translation": "Lifting Capacity: 1-20 tons",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "1affc1566292": {
      "text": "工作职责。A3, A4",
      "translation": "Duty Class: A3, A4",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "6a2ddf528e37": {
      "text": "工作环境温度：-25℃～+40℃，相对湿度≤85%",
      "translation": "Working environment temperature: -25℃～+40℃, relative humidity ≤85%",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "348a972c39d6": {
      "text": "起重机控制模式。地面控制/远程控制/机舱室",
      "translation": "Control Method: Ground Control / Remote Control / Cabin",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "c7a0ed09c1f1": {
      "text": "参考价格范围。<span>$750-4500/套</span><div></div>",
      "translation": "Reference price range: <span>$750-4500/set</span><div></div>",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
