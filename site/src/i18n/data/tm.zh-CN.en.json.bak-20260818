      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "af63fd6a43cd": {
      "text": "土库曼斯坦10吨LDC型单梁桥式起重机",
      "translation": "10-ton LDC Single Girder Overhead Crane in Turkmenistan",
      "status": "draft",
