    "214e26bc68f7": {
      "text": "半龙门起重机正文",
      "translation": "Semi-Gantry Crane Body",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "749fdd7d3f8a": {
      "text": "半龙门起重机是一种轨道式起重设备，主要由门架（含主梁、支腿和下横梁）、起升机构、运行机构和电气控制系统组成。",
      "translation": "A semi-gantry crane is a rail-mounted lifting equipment, mainly composed of a gantry frame (including main girder, legs, and bottom crossbeam), hoisting mechanism, travel mechanism, and electrical control system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "35f4c5a6a373": {
      "text": "门架一侧设有支腿沿地面轨道运行，另一侧不设支腿，沿建筑结构的上方轨道运行。",
      "translation": "One side of the gantry frame has legs running on ground rails, while the other side has no legs and runs on an overhead rail along the building structure.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "0efd51ae93d7": {
      "text": "以下为半龙门起重机（MHB 系列）的价格参考：",
      "translation": "Below is a price reference for Semi-Gantry Crane (MHB series):",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
