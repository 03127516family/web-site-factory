    "6efd8e3744ea": {
      "text": "便携式龙门起重机正文",
      "translation": "Portable Gantry Crane Content",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "dd951f68a3a9": {
      "text": "便携式龙门起重机是一种轻型龙门起重设备，通常由简化的钢架结构、可移动脚轮和电动或手动葫芦组成。",
      "translation": "A portable gantry crane is a light-duty gantry lifting device, typically composed of a simplified steel frame structure, movable casters, and an electric or manual hoist.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "a8ce30e06f81": {
      "text": "起重量一般为 0.5 吨至 10 吨，常用于仓库、维修车间和工厂生产线，用于搬运小型机械、零部件或模具。",
      "translation": "The lifting capacity is generally 0.5t to 10t, commonly used in warehouses, maintenance workshops, and factory production lines for handling small machinery, parts, or molds.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "71318284ca27": {
      "text": "以下为小型龙门起重机（便携移动门架）的价格参考：",
      "translation": "Below is a price reference for small gantry cranes (portable movable gantry):",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
