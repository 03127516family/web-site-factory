      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "4f17dc26c5b1": {
      "text": "卡塔尔10吨LDC型单梁桥式起重机 3",
      "translation": "10-ton LDC Single Girder Overhead Crane in Qatar 3",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "cdf44d2a2151": {
      "text": "10吨LD型单梁桥式起重机在贝宁 2",
      "translation": "10-ton LD Single Girder Overhead Crane in Benin 2",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "e7b99cc01a40": {
      "text": "卡塔尔10吨LDC型单梁桥式起重机 1",
      "translation": "10-ton LDC Single Girder Overhead Crane in Qatar 1",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "431c3e2a05ac": {
      "text": "卡塔尔10吨LDC型单梁桥式起重机 2",
      "translation": "10-ton LDC Single Girder Overhead Crane in Qatar 2",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "7f4e16e800c2": {
      "text": "10吨LD型单梁桥式起重机在贝宁 1",
      "translation": "10-ton LD Single Girder Overhead Crane in Benin 1",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "ae73d0f17ed5": {
      "text": "20吨单梁桥式起重机 2",
      "translation": "20-ton Single Girder Overhead Crane 2",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "ea48f136cf02": {
      "text": "20吨单梁桥式起重机1台",
      "translation": "20-ton Single Girder Overhead Crane 1",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "2dff8ab53a85": {
      "text": "单梁 eot 起重机由单根桥梁、两条轨道、端部卡车、两条跑道梁和一台用于提升在桥梁上运行的负载的起重机组成。",
      "translation": "A Single Girder EOT crane consists of a single bridge, two rails, end trucks, two runway beams, and a hoist for lifting loads that travel on the bridge.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "ba0b1e14fcca": {
      "text": "端车在固定在跑道横梁上的轨道上运行。",
      "translation": "The end trucks run on rails fixed to the runway beams.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "378ed5e7dfe0": {
      "text": "它是中重载最具成本效益的设备之一。",
      "translation": "It is one of the most cost-effective equipment for medium to heavy loads.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "e79d37ea5dcc": {
      "text": "单梁 eot 起重机为覆盖区域和运动控制提供最大的灵活性。",
      "translation": "The Single Girder EOT crane offers maximum flexibility in coverage area and motion control.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "59d2d743dfb8": {
      "text": "与安装在工厂上部一样，单梁起重机占用的地面空间最少，在移动范围内遇到的障碍物最少。",
      "translation": "Like being installed at the top of the factory, the Single Girder crane occupies minimal floor space and encounters the least obstacles within its movement range.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "34ae72c20dcf": {
      "text": "经过多年的努力，我公司已成功跻身国内一流的单梁起重机制造商行列。",
      "translation": "After years of effort, our company has successfully ranked among the top domestic manufacturers of Single Girder cranes.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "ae85ad790be5": {
      "text": "可以对单梁 eot 起重机进行修改以适应不断变化的需求。",
      "translation": "The Single Girder EOT crane can be modified to adapt to changing needs.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "f3b3a0d2ffbc": {
      "text": "这种设备的操作相当灵活。",
      "translation": "The operation of this equipment is quite flexible.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "c16632877120": {
      "text": "它也很容易根据您工厂的独特条件以及生产和负载的多样性进行定制。",
      "translation": "It is also easy to customize according to the unique conditions of your plant and the diversity of production and loads.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "d51ed576c557": {
      "text": "单梁EOT起重机",
      "translation": "Single Girder EOT Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "4447b75be1c4": {
      "text": "DGCRANE的桥式起重机的优势",
      "translation": "Advantages of DGCRANE Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "43900fb10e35": {
      "text": "我公司的单梁eot起重机旨在满足各种不同的需求。",
      "translation": "Our single girder EOT cranes are designed to meet a variety of different needs.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "728c410f9bb3": {
      "text": "它们可以以最具成本效益的方式提供出色的性能，而不会做出任何妥协。",
      "translation": "They deliver outstanding performance in the most cost-effective way without any compromise.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "57fb0184e8e7": {
      "text": "凭借我们先进的技术，我们的产品可以通过轻柔的运动将原材料输送到精确的位置。",
      "translation": "With our advanced technology, our products can transport raw materials to precise positions with gentle movements.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "22447854d086": {
      "text": "为了减轻单梁起重机本身的重量，我们采用紧凑型设计，以尽量减少不必要的重量。",
      "translation": "To reduce the weight of the single girder crane itself, we adopt a compact design to minimize unnecessary weight.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "34a17fa0e8f1": {
      "text": "这意味着起重机的效率更高，您的成本更低。",
      "translation": "This means the crane operates more efficiently and your costs are lower.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "251911df0617": {
      "text": "我们的单梁 eot 起重机将以极少的服务运行得更好，运行时间更长！",
      "translation": "Our single girder EOT cranes will run better and last longer with minimal service!",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "a81aeddec912": {
      "text": "应该注意什么？",
      "translation": "What should be noted?",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.013Z"
    },
    "f75bda89fea9": {
      "text": "为确保设备和操作人员的安全，在使用期间，应遵守产品的说明。",
      "translation": "To ensure the safety of equipment and operators, the product instructions should be followed during use.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2dcc4684bbb4": {
      "text": "确保将要提升的负载在起重机的安全负载范围内。",
      "translation": "Ensure that the load to be lifted is within the safe load range of the crane.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "156812035954": {
      "text": "切勿超过规定的最大负载能力。",
      "translation": "Never exceed the specified maximum load capacity.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "58c45f1fb23f": {
      "text": "轻轻地、平稳地移动负载。",
      "translation": "Move loads gently and smoothly.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "797deee4bfb0": {
      "text": "应避免尖锐、生硬的运动。",
      "translation": "Sharp and jerky movements should be avoided.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "86e2509e3362": {
      "text": "当紧急情况出现时，操作员可以有时间来处理。",
      "translation": "When an emergency occurs, the operator can have time to handle it.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "c8f6d71dfffc": {
      "text": "在运动开始前，运动范围内的空间应该是清晰的。",
      "translation": "Before starting movement, the space within the movement range should be clear.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "d7375201bee5": {
      "text": "不允许有任何人和障碍物。",
      "translation": "No people or obstacles are allowed.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "17edd28da405": {
      "text": "水平运动也必须缓慢开始，以防止负载摆动或与其他障碍物接触。",
      "translation": "Horizontal movement must also start slowly to prevent load swing or contact with other obstacles.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "ebfcd0d11dc0": {
      "text": "单梁起重机在工作期间应始终受到密切监督。",
      "translation": "The single girder crane should always be closely supervised during operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2e62ea5c3091": {
      "text": "不要在没有人看管的情况下单独离开起重机。",
      "translation": "Do not leave the crane unattended.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "1f757e2c9501": {
      "text": "在工作一段时间后，应该对起重机及其部件进行检查。",
      "translation": "After a period of operation, the crane and its components should be inspected.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "8f3f526aacbb": {
      "text": "检查的时间间隔取决于实际使用情况。",
      "translation": "The inspection interval depends on actual usage.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "4c0b256ea504": {
      "text": "端梁",
      "translation": "End Carriage",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "8ebad78286b9": {
      "text": "电动升降机",
      "translation": "Electric Hoist",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
