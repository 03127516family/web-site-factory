      "text": "起重机马达",
      "translation": "Crane Motor",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "506c432c3e6a": {
      "text": "起重机轮",
      "translation": "Crane Wheel",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "ad00a54c6cf7": {
      "text": "钩状物",
      "translation": "Hook Assembly",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "7effe13892c6": {
      "text": "末端停止保险杠",
      "translation": "End Stop Bumper",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "d24d91e89108": {
      "text": "电气柜",
      "translation": "Electrical Cabinet",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "bf999ea7acdd": {
      "text": "一台标准的单梁桥式起重机将在20天内生产出来。",
      "translation": "A standard single girder overhead crane will be produced within 20 days.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "ac85f5bf4817": {
      "text": "焊接加劲器",
      "translation": "Welding Stiffeners",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "7334febf7ad0": {
      "text": "焊接工字钢和盖板",
      "translation": "Welding I-Beam and Cover Plate",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "8d7f0209ccd1": {
      "text": "仙鹤画",
      "translation": "Crane Painting",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "e072bd6d834f": {
      "text": "来料检验 → 钢板开卷和开裂 → 钢板切割 → 滚动槽 → 焊接加劲器 → 焊接工字钢和盖板 → 起重机预装 → 仙鹤画 → 起重机包装和交付",
      "translation": "Incoming material inspection → Steel plate uncoiling and slitting → Steel plate cutting → Rolling grooves → Welding stiffeners → Welding I-beam and cover plate → Crane pre-assembly → Crane painting → Crane packaging and delivery",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "c7650cbed794": {
      "text": "LDA（普通单梁桥式起重机）。",
      "translation": "LDA (Standard Single Girder Overhead Crane).",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "a62465f463d2": {
      "text": "LDC（低净空单梁桥式起重机）。",
      "translation": "LDC (Low Headroom Single Girder Overhead Crane).",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "1142b10559d2": {
      "text": "LDP（部分悬挂式单梁桥式起重机）。",
      "translation": "LDP (Partially Underhung Single Girder Overhead Crane).",
      "status": "draft",
