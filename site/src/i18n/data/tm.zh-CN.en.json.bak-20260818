    },
    "dad2e2b7b65a": {
      "text": "自动化控制与远程操作系统集成",
      "translation": "Automated control and remote operating system integration",
      "status": "approved",
      "origin": "harvest",
      "updatedAt": "2026-08-14T03:03:38.353Z"
    },
    "e013b21586fd": {
      "text": "出口合规性和本地化适应设计",
      "translation": "Export compliance and localization-adapted design",
      "status": "approved",
