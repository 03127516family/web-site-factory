    "5ef8fd33c8a4": {
      "text": "双梁龙门起重机正文",
      "translation": "Double Girder Gantry Crane Content",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "592963bab316": {
      "text": "双梁龙门起重机主要由门架、小车、大车运行机构、操作室和电气控制系统组成。",
      "translation": "Double Girder Gantry Crane mainly consists of the gantry frame, trolley, crane traveling mechanism, operator's cab, and electrical control system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "da916dcac842": {
      "text": "门架可采用箱型或桁架型结构，主梁采用双梁偏轨设计。",
      "translation": "The gantry frame can adopt box-type or truss-type structure, and the Main Girder adopts a double-girder offset rail design.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "a026a6d60e9e": {
      "text": "根据用户需求，支腿可设计为 A 型或 U 型。",
      "translation": "According to user requirements, the legs can be designed as A-type or U-type.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "265e180804a8": {
      "text": "操作方式采用封闭式驾驶室，配备可调座椅、绝缘地垫和钢化玻璃窗。",
      "translation": "The operation mode adopts a closed cab, equipped with adjustable seat, insulating floor mat, and tempered glass windows.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "aa7d9aaadabf": {
      "text": "根据客户需要，驾驶室还可加装冷暖空调、蜂鸣器和对讲系统。",
      "translation": "According to customer needs, the cab can also be equipped with heating and cooling air conditioning, buzzer, and intercom system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
    "3e533c057523": {
      "text": "供电方式可选电缆卷筒或滑触线。",
      "translation": "Power supply options include cable reel or sliding contact line.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:36:45.814Z"
    },
