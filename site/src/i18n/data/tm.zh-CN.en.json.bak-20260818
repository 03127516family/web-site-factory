    },
    "c99d8502e727": {
      "text": "5吨桥式起重机终极指南：类型、价格与应用 | DGCRANE",
      "translation": "5 Ton Overhead Crane: The Ultimate Guide to Types, Prices & Applications | DGCRANE",
      "status": "approved",
      "origin": "harvest",
      "updatedAt": "2026-08-14T03:03:38.385Z"
    },
    "8dca3b81f282": {
      "text": "5吨桥式起重机（5 Ton Overhead Crane）终极指南：单梁/双梁/低净空/下悬/FEM 欧标等类型介绍、标准与定制价格区间、影响成本的关键因素、各类型参数对比与真实案例，助你选对中型吊装设备。",
      "translation": "The ultimate guide to 5 ton overhead cranes: single girder / double girder / low headroom / underhung / FEM European-standard types, standard and customized price ranges, key cost factors, side-by-side parameter comparison and real project cases — everything you need to choose the right mid-capacity lifting equipment.",
      "status": "approved",
      "origin": "harvest",
      "updatedAt": "2026-08-14T03:03:38.385Z"
    },
    "0d3bd2371584": {
      "text": "5吨桥式起重机终极指南：类型、价格与应用",
      "translation": "5 Ton Overhead Crane: The Ultimate Guide to Types, Prices & Applications",
      "status": "approved",
