    },
    "e8c6777e8ab6": {
      "text": "港口和堆场物料搬运解决方案",
      "translation": "Port and yard material-handling solutions",
      "status": "approved",
      "origin": "harvest",
      "updatedAt": "2026-08-14T03:03:38.353Z"
    },
    "aec9f98d2ca1": {
      "text": "针对高温、低温、沿海和高腐蚀性环境的特殊设计",
      "translation": "Special designs for high-temperature, low-temperature, coastal, and highly corrosive environments",
      "status": "approved",
      "origin": "harvest",
      "updatedAt": "2026-08-14T03:03:38.353Z"
    },
    "42b1fcbbedf4": {
      "text": "非标准跨距、提升高度和负载等级优化",
      "translation": "Non-standard span, lifting height, and load-class optimization",
      "status": "approved",
