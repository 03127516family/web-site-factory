    },
    "c9eaf4f573b4": {
      "text": "5吨和10吨的单梁桥式起重机出售到塔吉克斯坦",
      "translation": "5-ton and 10-ton Single Girder Overhead Cranes Sold to Tajikistan",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "1c405a10b3a0": {
      "text": "2套单梁桥式起重机出售到巴拿马",
      "translation": "2 Sets of Single Girder Overhead Cranes Sold to Panama",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "b7326907709b": {
      "text": "5吨和10吨单梁桥式起重机销售到印度",
      "translation": "5-ton and 10-ton Single Girder Overhead Cranes Sold to India",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "1f40a5deb304": {
      "text": "2台10吨单梁桥式起重机带6套电动环链葫芦销售到斯里兰卡",
      "translation": "2 Units of 10-ton Single Girder Overhead Cranes with 6 Sets of Electric Chain Hoists Sold to Sri Lanka",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "3091fe369755": {
      "text": "3吨和8吨LDC型单梁桥式起重机出售给乌拉圭",
      "translation": "3-ton and 8-ton LDC Type Single Girder Overhead Cranes Sold to Uruguay",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "3ee53f352d14": {
      "text": "悬挂式起重机",
      "translation": "Underslung Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "8806e7a0bcc6": {
      "text": "悬挂式桥式起重机与CD1、MD1电动葫芦配合使用，成为在轨道上运行的轻小型起重机。应用于机械、装配现场、仓库等场所",
      "translation": "The underslung overhead crane, combined with CD1 and MD1 electric hoists, becomes a light-duty crane running on rails. It is applied in machinery, assembly sites, warehouses, and other places.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "f911a18d07d8": {
      "text": "双梁桥式起重机",
      "translation": "Double Girder Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "c4f32650076d": {
      "text": "双梁、双轨、单吊小车。适用于各种工况。技术成熟，安全可靠，操作简便，运行稳定。",
      "translation": "Double girder, double rail, single trolley. Suitable for various working conditions. Mature technology, safe and reliable, easy operation, and stable running.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "d9456516b192": {
      "text": "欧式桥式起重机广泛用于机械制造、石油、石化、港口、铁路、民航、电力、食品、造纸、建材、电子等行业的车间和仓库等物料搬运场合。它们特别适用于需要精确定位的材料处理。, 大型部件的精密装配等场合。",
      "translation": "European-style overhead cranes are widely used for material handling in workshops and warehouses in industries such as machinery manufacturing, petroleum, petrochemical, ports, railways, civil aviation, electric power, food, papermaking, building materials, electronics, etc. They are especially suitable for material handling requiring precise positioning, precision assembly of large components, and other occasions.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "668c755cbb3b": {
      "text": "电动单梁桥式起重机是根据GB3811-2008和JB/T1306-2008标准设计的。",
      "translation": "The electric single girder overhead crane is designed according to GB3811-2008 and JB/T1306-2008 standards.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "e28a80d6b87b": {
      "text": "它是以CD1、MD1、WH164电动葫芦、环链电动葫芦为起重机构的车间起重设备。",
      "translation": "It is a workshop lifting equipment with CD1, MD1, WH164 electric hoists and chain electric hoists as the lifting mechanism.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "26dc65619cd8": {
      "text": "它广泛用于机械加工、装配、修理、仓库等工作场所。",
      "translation": "It is widely used in workplaces such as machining, assembly, repair, and warehouses.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "8110ba4c3e7f": {
      "text": "它是现代工业企业实现生产过程机械化、自动化，减少繁重的手工劳动，提高劳动生产率的重要工具和设备。",
      "translation": "It is an important tool and equipment for modern industrial enterprises to realize mechanization and automation of production processes, reduce heavy manual labor, and improve labor productivity.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "37b94460cfd5": {
      "text": "主要部件有桥架、电动葫芦、电控系统。",
      "translation": "The main components include the bridge frame, electric hoist, and electrical control system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "4c56d792f57e": {
      "text": "起重机电源为三相交流电，额定频率为50Hz或60Hz。",
      "translation": "The crane power supply is three-phase AC, with a rated frequency of 50Hz or 60Hz.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "7f8cdfc05955": {
      "text": "额定电压为220V～660V。",
      "translation": "The rated voltage is 220V to 660V.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "128ff964a9a9": {
      "text": "起重机的运行机构采用分离驱动方式，驱动和制动由锥形转子/软启动电机完成，传动采用“一开二闭”齿轮传动。",
      "translation": "The crane's travel mechanism adopts a separate drive mode. The drive and braking are completed by conical rotor/soft-start motors, and the transmission adopts an 'one open, two closed' gear drive.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "66129a9a267a": {
      "text": "起重机的操作模式可根据具体情况选择地面操作、遥控操作和驾驶室操作。",
      "translation": "The crane's operation mode can be selected as ground operation, remote control operation, and cab operation according to specific conditions.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "34d9111b681d": {
      "text": "结构紧凑，刚性好",
      "translation": "Compact structure, good rigidity",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "ed47bf44cb36": {
      "text": "易于操作",
      "translation": "Easy to operate",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "f88d61ae94ce": {
      "text": "安全和可靠",
      "translation": "Safe and reliable",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "5dd62851fa12": {
      "text": "罗斯梁：焊接箱梁结构，强度高",
      "translation": "Main Girder: Welded box girder structure, high strength",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "fa403a6a5985": {
      "text": "末端卡车：焊接箱梁结构，抗扭性强",
      "translation": "End Carriage: Welded box girder structure, strong torsional resistance",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "e6bb456f71eb": {
      "text": "旅行轮。",
      "translation": "Travel wheels.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "6ac4408e926e": {
      "text": "表面硬化的钢轮，高度耐磨",
      "translation": "Surface-hardened steel wheels, highly wear-resistant",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "182e62a6e8b4": {
      "text": "横梁和端部卡车之间的连接--按照精确的机加工公差制造，以减少磨损",
      "translation": "Connection between main girder and end carriage - manufactured to precise machining tolerances to reduce wear",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "be77e19014c6": {
      "text": "可选的葫芦。",
      "translation": "Optional hoist.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "d0fff2f7a9b7": {
      "text": "钢丝绳电动葫芦或低净空葫芦，用于更高的起吊高度",
      "translation": "Wire-rope Electric Hoist or Low Headroom hoist for higher lifting height",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "be3c16651aae": {
      "text": "通过安全滑动接触线提供电源",
      "translation": "Power supply via safe sliding contact line",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2ae21b99b1dc": {
      "text": "控制吊杆悬挂在起重机大梁上单独行走",
      "translation": "Control pendant travels independently suspended from the crane girder",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "482c03445546": {
      "text": "可选：无线电遥控",
      "translation": "Optional: radio Remote Control",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "04783009c364": {
      "text": "涂层：定制。",
      "translation": "Coating: customized.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "563cbec81c26": {
      "text": "通常漆面为金黄色。",
      "translation": "Usually painted golden yellow.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "567c7928493b": {
      "text": "旅行驱动器为天蓝色。",
      "translation": "Travel drive is sky blue.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "e1a9a2c536a8": {
      "text": "选项和组件",
      "translation": "Options and Components",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "8b5ceb0137d5": {
      "text": "主梁是起重机的主要承载部分，其结构采用U型槽、斜盖板、肋板及工字钢钢板制成，其上圆弧为（（1/1000～1.4/1000）S，当额定起重量及葫芦自重位于跨度中间时，引起的上拱度不低于水平线，正常运行时不产生永久变形。",
      "translation": "The Main Girder is the main load-bearing part of the crane. Its structure is made of U-shaped channel, inclined cover plate, rib plate, and I-beam steel plate. Its upper camber is ((1/1000～1.4/1000)S. When the rated Lifting Capacity and the hoist's own weight are at the middle of the Span, the resulting camber is not lower than the horizontal line, and no permanent deformation occurs during normal operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2df36875e62a": {
      "text": "端梁位于主梁的两端，通过法兰盘与主梁栓接。",
      "translation": "The End Carriage is located at both ends of the Main Girder and is bolted to the Main Girder through flanges.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "87917ca66bec": {
      "text": "它是箱型结构，由U型槽、下盖板、加强板以及由钢板轧制或钢板焊接而成的肋板组成。",
      "translation": "It is a box-type structure composed of U-shaped channel, lower cover plate, reinforcing plate, and rib plates rolled or welded from steel plates.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2f6696360975": {
      "text": "端梁具有结构轻、刚度好、外形美观、焊接性能好等特点。",
      "translation": "The End Carriage features light structure, good rigidity, beautiful appearance, and good welding performance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2bd32771eddb": {
      "text": "电动葫芦用于单梁桥式起重机上，每台电动葫芦都要进行动、静载荷试验，上升和下降压力试验。",
      "translation": "Electric Hoists are used on Single Girder Overhead Cranes. Each Electric Hoist undergoes dynamic and static load tests, as well as up and down pressure tests.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "bbe65855e390": {
      "text": "采用烤漆工艺，增强漆膜的附着力，提高外观质量。",
      "translation": "Baking paint process is adopted to enhance paint film adhesion and improve appearance quality.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "16f9e22f06a4": {
      "text": "装配线确保产品质量。",
      "translation": "Assembly line ensures product quality.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "128d7370611f": {
      "text": "驱动装置的箱体和箱盖由HT200灰铁铸造，具有良好的抗震性。",
      "translation": "The housing and cover of the drive unit are cast from HT200 gray iron, providing good shock resistance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "25167d963885": {
      "text": "经过时效处理后，在车床上用专用夹具加工制造。",
      "translation": "After aging treatment, they are machined on a lathe with special fixtures.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "f3d8260af380": {
      "text": "齿轮和齿轮轴由40Cr模锻而成，经车削、滚齿、回火、磨削而成。",
      "translation": "Gears and gear shafts are die-forged from 40Cr, then turned, gear hobbed, tempered, and ground.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "a19bec045a26": {
      "text": "热处理的硬度为HB235-269。",
      "translation": "Heat treatment hardness is HB235-269.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "bbcbaeed8a8a": {
      "text": "起重机电机采用ZDY(D)系列锥型转子制动电机或软启动电机。",
      "translation": "The crane motor adopts ZDY(D) series conical rotor brake motor or soft-start motor.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "cdd55c16e30d": {
      "text": "电机标准绝缘等级为B级，防护等级为IP44。",
      "translation": "The standard insulation class of the motor is Class B, with protection class IP44.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "621821379657": {
      "text": "电机具有散热性好、使用寿命长、安全可靠的特点。",
      "translation": "The motor features good heat dissipation, long service life, and safe and reliable operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "5a4fa5a8a019": {
      "text": "特殊工况下可以定制。",
      "translation": "Customization is available for special working conditions.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "e8d0ff0d7a34": {
      "text": "该轮组由45#钢模锻成型，经粗加工、淬火、回火、精加工而成。",
      "translation": "The wheel set is die-forged from 45# steel, processed through rough machining, quenching, tempering, and finish machining.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "11e7cf04dcbb": {
      "text": "热处理硬度为HB300～380，硬化层深度为15mm时硬度不低于HB260。",
      "translation": "Heat treatment hardness is HB300~380, with hardness not lower than HB260 at a hardened layer depth of 15mm.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "90f35cd9ba3a": {
      "text": "轮轴采用45#钢，经粗加工、淬火回火、精加工等工序加工而成。",
      "translation": "The wheel shaft is made of 45# steel, processed through rough machining, quenching and tempering, and finish machining.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "abc565a88553": {
      "text": "热处理硬度为235～269HB。",
      "translation": "Heat treatment hardness is 235~269HB.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "60383b81abde": {
      "text": "吊钩块符合GB/T1005.1～5-98标准，其材质为DG20，安全系数大于5；吊钩表面光滑，无裂纹、折叠、过烧等缺陷；内部无裂纹、白点等影响安全的现象。",
      "translation": "The hook block complies with GB/T1005.1~5-98 standard, made of DG20 material with a safety factor greater than 5; the hook surface is smooth, free from cracks, folds, overburning, and other defects; internally free from cracks, white spots, and other safety-affecting phenomena.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "cf53f8b4c716": {
      "text": "吊钩设有防脱钩装置，防止钢丝绳脱钩，确保吊钩在使用过程中安全可靠。",
      "translation": "The hook is equipped with an anti-detachment device to prevent wire rope detachment, ensuring safe and reliable operation during use.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "ce1dd76d1bf6": {
      "text": "JHQ-C系列聚氨酯缓冲器具有超强的防撞能力和良好的缓冲效果。",
      "translation": "The JHQ-C series polyurethane buffer provides superior anti-collision capability and excellent cushioning effect.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "5193cc627c9d": {
      "text": "结构简单，使用寿命长，安装和维护方便。",
      "translation": "Simple structure, long service life, and easy installation and maintenance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "66f6fa9e9321": {
      "text": "我们的标准电源是三相，380V（±10%，峰值电流下限为-15%），50Hz。",
      "translation": "Our standard power supply is three-phase, 380V (±10%, with a lower limit of -15% for peak current), 50Hz.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "c1dac7fdb67d": {
      "text": "根据客户要求，电源可以设计成690V以下，频率50-60HZ的三相电控系统。",
      "translation": "According to customer requirements, the power supply can be designed as a three-phase electrical control system below 690V, with frequency 50-60Hz.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "f81c2bd769ab": {
      "text": "操作面板、遥控、驾驶室控制。",
      "translation": "Operation panel, remote control, and cabin control.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "04888c723fcc": {
      "text": "起重机也可配备两套操作装置，即：地面+遥控或司机室+遥控。",
      "translation": "The crane can also be equipped with two sets of operation devices, namely: ground + remote control or cabin + remote control.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "4a7b0fdd28c2": {
      "text": "控制电路电压一般为交流36V安全电压。",
      "translation": "The control circuit voltage is generally AC 36V safety voltage.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "513ed5a17040": {
      "text": "主梁和端部车架通过螺栓连接，便于拆卸、运输和储存。",
      "translation": "The main girder and end carriage are connected by bolts, facilitating disassembly, transportation, and storage.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "c4016bdf4bbb": {
      "text": "自动焊接和流水线加工，安装快捷，维护方便。",
      "translation": "Automatic welding and assembly line processing ensure quick installation and easy maintenance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "be18d07bf3f8": {
      "text": "结构合理，刚性强，耐用。",
      "translation": "Reasonable structure, strong rigidity, and durability.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "5f70b4dc8c75": {
      "text": "主梁和端头车用螺栓连接，便于拆装、运输和储存。",
      "translation": "The main girder and end carriage are connected by bolts, facilitating disassembly, transportation, and storage.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "3759678f9ee7": {
      "text": "低净空设计，与普通型单梁桥式起重机相比，LDC型单梁桥式起重机可以有更高的起重高度，而且更节省空间。",
      "translation": "Low Headroom design, compared with standard Single Girder Overhead Crane, LDC Single Girder Overhead Crane can achieve higher Lifting Height and save more space.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "703b949e4911": {
      "text": "主梁和端部车架用螺栓连接，便于拆装、运输和储存。",
      "translation": "The main girder and end carriages are connected with bolts for easy assembly, disassembly, transport, and storage.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "f6d3e2ec2a28": {
      "text": "葫芦位于梁的一侧，与普通型单梁起重机和低净空单梁桥式起重机相比，它可以实现更高的起重高度。",
      "translation": "The hoist is positioned on one side of the girder, allowing for a higher lifting height compared to standard single girder cranes and low headroom single girder overhead cranes.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "42f3ea695e70": {
      "text": "结构紧凑，刚性好，操作灵敏。",
      "translation": "Compact structure, good rigidity, and sensitive operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "7609731fb94c": {
      "text": "安全可靠、外形美观、防爆性强等特点。",
      "translation": "Features include safety, reliability, attractive appearance, and strong explosion-proof performance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "565896704a19": {
      "text": "我们的防爆单梁桥式起重机的主要组成部分是：桥架、防爆电动葫芦、电控系统。",
      "translation": "The main components of our explosion-proof single girder overhead crane are: the bridge frame, explosion-proof electric hoist, and electrical control system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "b78922813eef": {
      "text": "LDY（冶金电动单梁桥式起重机）起重机为A6级工况，适用于工作环境温度≤60℃，相对湿度≤85﹪，海拔2000米以下，无腐蚀性介质的环境条件。",
      "translation": "The LDY (Metallurgical Electric Single Girder Overhead Crane) is designed for A6 duty class, suitable for working environments with temperatures ≤60°C, relative humidity ≤85%, altitudes below 2000m, and without corrosive media.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "89391042ca20": {
      "text": "起重机的结构主要由三部分组成：桥架、冶金电动葫芦和电气系统。",
      "translation": "The crane structure mainly consists of three parts: the bridge frame, metallurgical electric hoist, and electrical system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "ba573f109878": {
      "text": "在电机和电控系统等电气设备外采用隔热保护措施。",
      "translation": "Heat insulation protection measures are applied to electrical equipment such as motors and control systems.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "d546b5c3327d": {
      "text": "电动抓斗单梁桥式起重机是一种与抓斗小车配套使用的车间起重设备。",
      "translation": "The electric grab single girder overhead crane is a workshop lifting device used in conjunction with a grab trolley.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "0270cb5a8fbc": {
      "text": "它广泛用于各种工作场所，如加工、装配、修理和仓库。",
      "translation": "It is widely used in various workplaces such as processing, assembly, repair, and warehouses.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "6fd591c49b60": {
      "text": "该起重机运行机构采用单独驱动方式，驱动与制动均由锥形转子电动机完成，传动采用“一开二闭”齿轮传动。",
      "translation": "The crane's travel mechanism adopts individual drive, with both driving and braking completed by conical rotor motors, and the transmission uses an 'one open, two closed' gear drive.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "0007784b71e4": {
      "text": "该产品具有结构紧凑、刚性好、操作简便、噪音低、安全可靠、外形美观等优点。",
      "translation": "This product features a compact structure, good rigidity, easy operation, low noise, safety, reliability, and attractive appearance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-15T08:38:47.014Z"
    },
    "2b7e6896d4cb": {
      "text": "xaxaxa - DGCRANE",
      "translation": "xaxaxa - DGCRANE",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "3be5f6058e86": {
      "text": "xaxaxa",
      "translation": "xaxaxa",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "c766f663f65c": {
      "text": "单梁桥式起重机厂家直销，价格优惠。",
      "translation": "Single Girder Overhead Crane factory direct sales with competitive prices.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "54f2363e3a9b": {
      "text": "整机结构紧凑，运行平稳，广泛应用于机械加工车间、装配线、货场仓库等场所。",
      "translation": "The whole machine is compact in structure and runs smoothly, widely used in machining workshops, assembly lines, warehouses, and other places.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "67fe295d919f": {
      "text": "起重量从1吨到20吨，跨度最长31.5米，工作级别A3到A5。",
      "translation": "Lifting Capacity ranges from 1 ton to 20 tons, Span up to 31.5 meters, Duty Class A3 to A5.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "501b6dc2acbf": {
      "text": "采用箱型主梁结构，焊接工艺经严格探伤检验，表面喷砂除锈后喷涂防锈漆。",
      "translation": "Adopting box-type Main Girder structure, welding process strictly inspected by flaw detection, surface sandblasting and rust removal followed by anti-rust paint spraying.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "bca814a922b8": {
      "text": "配备电动葫芦，起升机构双制动，安全可靠。",
      "translation": "Equipped with Electric Hoist, the hoisting mechanism has dual brakes, safe and reliable.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "2de6c2816d3c": {
      "text": "电气控制系统采用变频调速，起停平稳无冲击。",
      "translation": "The electrical control system adopts Variable Frequency speed regulation, with smooth start and stop without impact.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "f09a2528c6cd": {
      "text": "我们提供安装调试服务，整机质保一年，终身维护。",
      "translation": "We provide installation and commissioning services, with a one-year warranty for the whole machine and lifelong maintenance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "ef8e4018db81": {
      "text": "产品远销俄罗斯、东南亚、中东等国家和地区，欢迎来电咨询。",
      "translation": "Products are exported to Russia, Southeast Asia, the Middle East and other countries and regions. Welcome to inquire.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T09:53:13.294Z"
    },
    "79ea06852475": {
      "text": "双梁桥式起重机 - DGCRANE",
      "translation": "Double Girder Overhead Crane - DGCRANE",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "7976026ebd82": {
      "text": "起重量为5吨到320吨",
      "translation": "Lifting Capacity from 5 tons to 320 tons",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "bba4348185e9": {
      "text": "跨度为10.5米到31.5米",
      "translation": "Span from 10.5 meters to 31.5 meters",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "5c953afd9ec4": {
      "text": "起升高度为6米到24米，可以按需加高",
      "translation": "Lifting Height from 6 meters to 24 meters, extendable on request",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "e1d80187f47a": {
      "text": "工作级别为A3到A7，常用A5和A6",
      "translation": "Duty Class A3 to A7, commonly A5 and A6",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "da0bed439729": {
      "text": "工作电压为220V到690V，频率50Hz到60Hz，三相交流供电",
      "translation": "Power Supply 220V to 690V, frequency 50Hz to 60Hz, three-phase AC",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "fc5ff692df68": {
      "text": "工作环境温度为零下25摄氏度到零上40摄氏度，相对湿度不大于85%",
      "translation": "Working ambient temperature from -25°C to +40°C, relative humidity not exceeding 85%",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "98fb436ae52f": {
      "text": "起重机控制模式为地面控制、遥控控制或司机室控制",
      "translation": "Control Method: ground control, Remote Control, or cabin control",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "00f21e0ba747": {
      "text": "参考价格范围为每套12000美元到120000美元，具体取决于吨位、跨度、配置和选件",
      "translation": "Reference price range from $12,000 to $120,000 per set, depending on tonnage, span, configuration, and options",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "d75ba6530841": {
      "text": "双梁桥式起重机是一种横架于车间上部空间、沿两侧高架轨道纵向运行的桥架型起重设备，由两根平行的主梁、两根端梁、起重小车、大车运行机构和电气控制系统组成，配合吊钩、抓斗、电磁盘等取物装置，可以完成物料在车间覆盖范围内的起升和搬运作业。",
      "translation": "Double Girder Overhead Crane is a bridge-type lifting equipment that spans the upper space of a workshop and travels longitudinally along elevated rails on both sides. It consists of two parallel Main Girders, two End Carriages, a trolley, a crane traveling mechanism, and an electrical control system. Equipped with lifting devices such as hooks, grabs, and electromagnetic discs, it can lift and transport materials within the workshop coverage area.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "19f2353497fc": {
      "text": "整机按照GB3811-2008起重机设计规范和GB/T 14406-2017通用桥式起重机标准设计制造，起重量大、跨度大、工作级别高，广泛用于机械制造、冶金、钢铁、港口、电站、矿山等行业的车间和仓库，是现代工业企业实现生产过程机械化、自动化，减轻工人劳动强度，提高劳动生产率的重要工具和设备。",
      "translation": "The entire machine is designed and manufactured according to GB3811-2008 Crane Design Specification and GB/T 14406-2017 General Overhead Crane Standard. With large Lifting Capacity, large Span, and high Duty Class, it is widely used in workshops and warehouses in industries such as machinery manufacturing, metallurgy, steel, ports, power stations, and mining. It is an important tool and equipment for modern industrial enterprises to mechanize and automate production processes, reduce labor intensity, and improve labor productivity.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "81a64ad95673": {
      "text": "双梁桥式起重机可以根据厂房净空高度、工艺流程和吊运频次进行定制，起升机构既可以采用传统的电阻分级调速，也可以采用变频无级调速，实现平稳启制动和精确对位，满足装配、浇注、精密吊装等不同工况对定位精度的要求。",
      "translation": "Double Girder Overhead Crane can be customized according to the clear height of the workshop, process flow, and lifting frequency. The hoisting mechanism can adopt either traditional resistor stepped speed control or Variable Frequency stepless speed control, achieving smooth start/braking and precise positioning, meeting the positioning accuracy requirements of different working conditions such as assembly, pouring, and precision lifting.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "12292ee7bbd4": {
      "text": "对于高速产线和频繁作业的场合，双梁结构的刚性和稳定性优势更加明显。",
      "translation": "For high-speed production lines and frequent operation occasions, the rigidity and stability advantages of the Double Girder structure are more obvious.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "a8de554b1f36": {
      "text": "双梁桥式起重机的优势",
      "translation": "Advantages of Double Girder Overhead Crane",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "cd12b9740299": {
      "text": "双梁桥式起重机的优势非常突出。",
      "translation": "The advantages of Double Girder Overhead Crane are very prominent.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "bbb50ad636cf": {
      "text": "它的结构紧凑，刚性好，承载能力强。",
      "translation": "Its structure is compact, with good rigidity and strong load-bearing capacity.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "57c63d860770": {
      "text": "整机采用变频调速系统，启制动平稳，定位准确，对厂房结构的冲击小。",
      "translation": "The entire machine adopts a Variable Frequency speed control system, with smooth start/braking, accurate positioning, and minimal impact on the workshop structure.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "e757ff83ad17": {
      "text": "起升高度大，有效利用厂房上层空间。",
      "translation": "Large Lifting Height, effectively utilizing the upper space of the workshop.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "cc024616528d": {
      "text": "标准化程度高，零部件通用性强，维护保养方便。",
      "translation": "High degree of standardization, strong interchangeability of components, and convenient maintenance.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "afb4b2bf72ec": {
      "text": "整机经过抛丸除锈和烤漆处理，外观美观，防腐寿命长。",
      "translation": "The entire machine undergoes shot blasting and rust removal and baking paint treatment, with beautiful appearance and long Anti-corrosion life.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "9bd1da13038c": {
      "text": "安全保护装置齐全，运行可靠。",
      "translation": "Complete safety protection devices, reliable operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "11200db766c2": {
      "text": "低噪音设计，改善车间工作环境。",
      "translation": "Low noise design, improving the workshop working environment.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "13357dc805ab": {
      "text": "可以配置无线遥控操作，减少操作人员配置。",
      "translation": "Can be equipped with wireless Remote Control operation, reducing operator configuration.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "1c542f489c32": {
      "text": "能耗低，运行成本低，全寿命周期性价比高。",
      "translation": "Low energy consumption, low operating cost, and high cost-effectiveness over the full life cycle.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "5505d9fb6887": {
      "text": "安全保护",
      "translation": "Safety Protection",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "2da584e3cac0": {
      "text": "安全保护方面，双梁桥式起重机配置了多重保护装置。",
      "translation": "In terms of safety protection, the Double Girder Overhead Crane is equipped with multiple protection devices.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "184983c1a694": {
      "text": "变频器的保护功能可以对各驱动机构进行短路、过流、电机过热、欠压、过压、接地、防失速、散热器过热和制动单元过热保护。",
      "translation": "The protection functions of the Variable Frequency drive can provide short-circuit, overcurrent, motor overheating, undervoltage, overvoltage, ground fault, anti-stall, heatsink overheating, and braking unit overheating protection for each drive mechanism.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "41b606d199c1": {
      "text": "超载限制器在载荷达到额定起重量的90%时发出声光报警，达到100%时自动切断起升动作。",
      "translation": "The overload limiter emits an audible and visual alarm when the load reaches 90% of the rated Lifting Capacity, and automatically cuts off the hoisting action at 100%.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "a406aed1e04c": {
      "text": "起升机构设有上升极限位置限位器和下降极限位置限位器，大车和小车运行机构两端设有行程限位开关，运行到位自动减速停车。",
      "translation": "The hoisting mechanism is equipped with upper and lower limit switches, and the crane and trolley travel mechanisms have travel limit switches at both ends, automatically decelerating and stopping when reaching the limit.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "3d58f70b4cd0": {
      "text": "司机室门、栏杆门和检修舱口门设有联锁开关，门未关闭整机不能通电。",
      "translation": "The cabin door, railing door, and inspection hatch door are equipped with interlock switches; the machine cannot be powered on if the doors are not closed.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "c79d936f1fbd": {
      "text": "端梁两端装有聚氨酯缓冲器，配合轨道端部的止挡，减轻意外碰撞冲击。",
      "translation": "Both ends of the End Carriage are equipped with polyurethane buffers, which work with the rail end stops to mitigate accidental collision impacts.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "83d40588a554": {
      "text": "电控系统还设有失压保护、零位保护和紧急断电开关，故障状态下可以迅速切断总电源。",
      "translation": "The electrical control system also features undervoltage protection, zero-position protection, and an emergency power-off switch, allowing rapid disconnection of the main power supply in fault conditions.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "828c04433bfb": {
      "text": "主要部件",
      "translation": "Main Components",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "dd59d34a4148": {
      "text": "整机主要部件包括桥架、起重小车、大车运行机构、司机室和电控系统。",
      "translation": "The main components of the crane include the bridge frame, the trolley, the crane travel mechanism, the operator's cab, and the electrical control system.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "d07e1c7cbe26": {
      "text": "桥架采用钢板焊接箱形结构，焊后经过整体退火处理消除焊接应力；起重小车的起升机构采用变频制动电机配硬齿面减速器，传动效率高；大车运行机构采用分别驱动方式，每根端梁各配一套驱动装置，由变频器实现两端的同步调速。",
      "translation": "The bridge frame adopts a welded box-type structure made of steel plates, and is subjected to overall annealing treatment after welding to eliminate welding stress. The hoisting mechanism of the trolley uses a variable frequency brake motor paired with a hardened gear reducer, ensuring high transmission efficiency. The crane travel mechanism adopts a separate drive mode, with each End Carriage equipped with its own drive unit, and variable frequency drives achieve synchronized speed regulation at both ends.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "828e565895be": {
      "text": "主要参数",
      "translation": "Main Parameters",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "61adc5ef3276": {
      "text": "双梁桥式起重机的主要参数如下。",
      "translation": "The main parameters of the Double Girder Overhead Crane are as follows.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "9e571cc32d69": {
      "text": "起重量为5吨到320吨。",
      "translation": "The Lifting Capacity ranges from 5 tons to 320 tons.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "f011c2e65cb2": {
      "text": "跨度为10.5米到31.5米。",
      "translation": "The Span ranges from 10.5 meters to 31.5 meters.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "1a136a6832ab": {
      "text": "起升高度为6米到24米，可以按需加高。",
      "translation": "The Lifting Height ranges from 6 meters to 24 meters, and can be increased as required.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "339e8ccb23e9": {
      "text": "工作级别为A3到A7，常用A5和A6。",
      "translation": "The Duty Class ranges from A3 to A7, with A5 and A6 being common.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "af2d37f22dbf": {
      "text": "工作电压为220V到690V，频率50Hz到60Hz，三相交流供电。",
      "translation": "The working voltage is 220V to 690V, frequency 50Hz to 60Hz, three-phase AC power supply.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "db0e8b5d2d02": {
      "text": "工作环境温度为零下25摄氏度到零上40摄氏度，相对湿度不大于85%。",
      "translation": "The working environment temperature ranges from -25°C to +40°C, with relative humidity not exceeding 85%.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "e51713bc34c1": {
      "text": "起重机控制模式为地面控制、遥控控制或司机室控制。",
      "translation": "The crane Control Method can be ground control, Remote Control, or cab control.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "ffb047579d23": {
      "text": "参考价格范围为每套12000美元到120000美元，具体取决于吨位、跨度、配置和选件。",
      "translation": "The reference price ranges from $12,000 to $120,000 per unit, depending on tonnage, span, configuration, and options.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "ea4a890186b2": {
      "text": "技术参数对比",
      "translation": "Technical Parameter Comparison",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "d3c07f12f89f": {
      "text": "以常用的QD系列吊钩桥式起重机为例，不同吨位的简要技术参数对比如下。",
      "translation": "Taking the common QD series hook Overhead Crane as an example, the brief technical parameter comparison for different tonnages is as follows.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "932e97532ddf": {
      "text": "QD5型的起重量为5吨，跨度10.5米到31.5米，起升高度6米到16米，整机重量8吨到30吨，最大轮压约160千牛。",
      "translation": "The QD5 model has a Lifting Capacity of 5 tons, a Span of 10.5 to 31.5 meters, a Lifting Height of 6 to 16 meters, a total weight of 8 to 30 tons, and a maximum wheel load of approximately 160 kN.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "de910d3fe8b4": {
      "text": "QD10型的起重量为10吨，跨度10.5米到31.5米，起升高度9米到16米，整机重量10吨到38吨，最大轮压约200千牛。",
      "translation": "The QD10 model has a Lifting Capacity of 10 tons, a Span of 10.5 to 31.5 meters, a Lifting Height of 9 to 16 meters, a total weight of 10 to 38 tons, and a maximum wheel load of approximately 200 kN.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "b276076cf46f": {
      "text": "QD20型的起重量为20吨，跨度10.5米到31.5米，起升高度9米到18米，整机重量16吨到52吨，最大轮压约280千牛。",
      "translation": "The QD20 model has a Lifting Capacity of 20 tons, a Span of 10.5 to 31.5 meters, a Lifting Height of 9 to 18 meters, a total weight of 16 to 52 tons, and a maximum wheel load of approximately 280 kN.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "8c5364349ec9": {
      "text": "QD50型的起重量为50吨，跨度10.5米到31.5米，起升高度9米到20米，整机重量30吨到85吨，最大轮压约400千牛。",
      "translation": "The QD50 model has a Lifting Capacity of 50 tons, a Span of 10.5 to 31.5 meters, a Lifting Height of 9 to 20 meters, a total weight of 30 to 85 tons, and a maximum wheel load of approximately 400 kN.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "ebde99c6e810": {
      "text": "细节规格",
      "translation": "Detailed Specifications",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "6a609e0eb904": {
      "text": "细节规格可以按照要求提供。",
      "translation": "Detailed specifications can be provided upon request.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "b2ab33812573": {
      "text": "以QD10吨跨度22.5米常用型号为例，主起升速度为每分钟7.7米，副起升速度为每分钟12米，小车运行速度为每分钟44米，大车运行速度为每分钟66米，主起升电机功率13千瓦，副起升电机功率7.5千瓦，小车运行电机功率3.7千瓦，大车运行电机功率2乘以5.5千瓦，整机总功率约45千瓦，建议采用43千克每米钢轨，最大轮压约195千牛，整机自重约22吨。",
      "translation": "",
      "status": "failed",
      "origin": "engine",
      "error": "map-missing:起升速度→Lifting Speed",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "516a067dc755": {
      "text": "单梁和双梁桥式起重机哪个更好",
      "translation": "Which is Better: Single Girder or Double Girder Overhead Crane?",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "49c9915fc1a3": {
      "text": "关于单梁和双梁桥式起重机哪个更好，一般来说，起重量20吨以下、跨度和吊运频次不高的场合，单梁桥式起重机的性价比更高；起重量超过20吨、需要主副双钩协同、配装抓斗电磁盘或者使用频繁的场合，双梁桥式起重机更先进、更好。",
      "translation": "Regarding which is better between Single Girder and Double Girder Overhead Cranes, generally speaking, for applications with a Lifting Capacity below 20 tons, moderate Span, and low handling frequency, Single Girder Overhead Cranes offer higher cost-effectiveness. For applications with a Lifting Capacity exceeding 20 tons, requiring main and auxiliary hooks for coordinated operation, equipped with grabs or electromagnets, or used frequently, Double Girder Overhead Cranes are more advanced and better.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "b53857697cc9": {
      "text": "而在工作条件、操作条件和价格方面，合适的才是最好的。",
      "translation": "However, in terms of working conditions, operating conditions, and price, the most suitable one is the best.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "6d7fdff166d0": {
      "text": "我们有单梁、双梁、欧式、防爆等不同类型的桥式起重机，并有灵活的销售方案，很荣幸为您推荐合适的起重机。",
      "translation": "We offer different types of Overhead Cranes, including Single Girder, Double Girder, European-style, and Explosion-proof, with flexible sales solutions. We are honored to recommend the right crane for you.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "6d0c33287da9": {
      "text": "双梁桥式起重机以两根箱形焊接主梁为主要承载构件，主梁与端梁之间通过法兰板用高强度螺栓连接，便于拆卸、运输和现场组装。",
      "translation": "The Double Girder Overhead Crane uses two box-type welded Main Girders as the main load-bearing components. The Main Girders are connected to the End Carriages via flange plates with high-strength bolts, facilitating disassembly, transportation, and on-site assembly.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "bd2a709742ab": {
      "text": "起重小车沿铺设在两根主梁上盖板上的轨道横向运行，小车上的起升机构通过钢丝绳卷筒带动吊钩起落，大车运行机构驱动两端梁上的车轮沿厂房轨道纵向运行，起升、小车、大车三个方向的运动相互独立又协调联动，覆盖整个车间作业面。",
      "translation": "The trolley travels transversely along rails laid on the top plates of the two Main Girders. The hoisting mechanism on the trolley raises and lowers the hook via a wire-rope drum. The crane travel mechanism drives the wheels on both End Carriages to move longitudinally along the factory rails. The movements in the hoisting, trolley, and crane travel directions are independent yet coordinated, covering the entire workshop working area.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "9403939563fd": {
      "text": "与单梁桥式起重机相比，双梁桥式起重机的承载能力更大，整机刚度更好，运行更加平稳，可以配置主副双钩协同作业，也可以配装抓斗、电磁盘、夹钳等专用取物装置，满足散料装卸、废钢吊运、高温物料搬运等特殊吊运需求。",
      "translation": "Compared with Single Girder Overhead Crane, Double Girder Overhead Crane offers greater lifting capacity, better overall rigidity, and smoother operation. It can be equipped with main and auxiliary hooks for coordinated work, or fitted with specialized grabbing devices such as grabs, electromagnetic chucks, and clamps to meet special lifting needs like bulk material handling, scrap steel lifting, and high-temperature material transport.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "75e1f9d556b0": {
      "text": "整机可以根据用户工厂的独特条件以及生产和负载的多样性进行修改和定制，以适应不断变化的工艺要求。",
      "translation": "The entire machine can be modified and customized according to the unique conditions of the user's factory and the diversity of production and loads, to adapt to changing process requirements.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "087db63ab10b": {
      "text": "安装",
      "translation": "Installation",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "9801f5025c49": {
      "text": "安装方面，可以进行现场安装或远程指导。",
      "translation": "For installation, on-site installation or remote guidance is available.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "6fc788bd9844": {
      "text": "对于首次使用起重机或者改造旧车间的用户，我们建议派工程师到现场安装调试；对于有安装能力的用户，我们提供详细的安装图纸和视频指导，远程协助完成调试。",
      "translation": "For users who are using cranes for the first time or renovating old workshops, we recommend sending engineers for on-site installation and commissioning; for users with installation capabilities, we provide detailed installation drawings and video guidance, and assist with commissioning remotely.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "056dc954b542": {
      "text": "出国安装的工程师都具有多年现场经验，能用英语或俄语沟通，一台标准的双梁桥式起重机从货物到齐到试车完成通常需要7天到15天。",
      "translation": "Engineers for overseas installation have years of field experience and can communicate in English or Russian. A standard Double Girder Overhead Crane typically takes 7 to 15 days from arrival of goods to completion of trial operation.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    },
    "927f2f515309": {
      "text": "设备安装完成后，工程师会对整机进行空载、静载和动载试验，试验合格后组织验收，并对用户的操作人员和维护人员进行免费培训。",
      "translation": "After installation, engineers will conduct no-load, static load, and dynamic load tests on the entire machine. After passing the tests, acceptance is organized, and free training is provided for the user's operators and maintenance personnel.",
      "status": "draft",
      "origin": "engine",
      "updatedAt": "2026-08-17T10:04:32.098Z"
    }
  }
}
