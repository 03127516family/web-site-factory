---
// en 镜像文章路由：content/en/posts/*.json（镜像树，R35：同一骨架不同文字）。
// 布局组件与 zh 源共用——按 pageId（文件名）派发 components/posts/<pageId>.astro（T2）。
// 生产内容源 = productionJson（approved 投影：只出已审句，缺句照删、核心字段未审整页不出）；
// 编辑预览（INCLUDE_DRAFTS=1）读镜像文件全文（含草稿/占位/pending 注解，供审阅高亮）。
import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import Chrome from '@layouts/Chrome.astro'
import { scanPages, buildGroups, productionJson } from '../../../i18n.mjs'

export function getStaticPaths() {
  const dir = join(process.cwd(), 'content/en/posts')
  if (!existsSync(dir)) return [] // 该语言还没有此类型镜像
  // 有骨架才出页：套件目录（components/posts/<名>/）或扁平组件任一（glob 须在函数体内现调，Astro 提 chunk 限制）
  const haveLayout = new Set([
    ...Object.keys(import.meta.glob('../../../components/posts/*/index.astro')).map(p => p.split('/').at(-2)),
    ...Object.keys(import.meta.glob('../../../components/posts/*.astro')).map(p => p.split('/').pop().replace('.astro', '')),
  ])
  const pages = scanPages({ withJson: true })
  const groups = buildGroups(pages)
  const bySlug = new Map(pages.map(p => [p.slug, p]))
  return readdirSync(dir)
    .filter(f => f.endsWith('.json') && haveLayout.has(f.replace('.json', '')))
    .map(f => ({ params: { slug: f.replace('.json', '') }, j: JSON.parse(readFileSync(join(dir, f), 'utf8')) }))
    .map(p => {
      if (process.env.INCLUDE_DRAFTS === '1') return { params: p.params, props: { j: p.j } } // 预览=镜像全文
      const me = bySlug.get(p.j.page.slug)
      const j = me && productionJson(me, groups, pages) // 生产=approved 投影（null=不出页）
      return j ? { params: p.params, props: { j } } : null
    })
    .filter(Boolean)
}

const { j } = Astro.props
const slug = Astro.params.slug
// 派发同 zh：数据声明 template 的套件优先 → 同名套件（en JSON 的 template 仍是旧路径式）→ 扁平回退
// glob 键后缀化（zh 路由同款）：查表用 posts/<名>/…，不数 ../../../
const bySuffix = o => Object.fromEntries(Object.entries(o).map(([k, v]) => [k.slice(k.indexOf('/posts/') + 1), v]))
const kitLayouts = bySuffix(import.meta.glob('@components/posts/*/index.astro'))
const flatLayouts = bySuffix(import.meta.glob('@components/posts/*.astro'))
const kit = kitLayouts[`posts/${j.page.template}/index.astro`]
  ?? kitLayouts[`posts/${slug}/index.astro`]
const Comp = kit ? (await kit()).default : (await flatLayouts[`posts/${slug}.astro`]()).default
---
<Chrome j={j}>
	<Comp j={j} />
</Chrome>
