---
// 语言镜像文章路由（[lang] 泛化，R35→任意语言）：content/<lang>/posts/*.json。
// lang 由 getStaticPaths 从 langDirs() 枚举（与 scanPages 同一条规则）——新增语言零登记。
// 布局组件与 zh 源共用——按 pageId（文件名）派发 components/posts/<pageId>.astro（T2）。
// 生产内容源 = productionJson（approved 投影：只出已审句，缺句照删、核心字段未审整页不出）；
// 编辑预览（INCLUDE_DRAFTS=1）读镜像文件全文（含草稿/占位/pending 注解，供审阅高亮）。
import { readFileSync, readdirSync, existsSync } from 'node:fs'
import { join } from 'node:path'
import Chrome from '@layouts/Chrome.astro'
import { scanPages, buildGroups, productionJson, langDirs } from '../../../i18n.mjs'

export function getStaticPaths() {
  // glob 须在函数体内现调（Astro 构建把 getStaticPaths 提到独立 chunk，吃不到 frontmatter 顶层变量）
  const flatNames = new Set(Object.keys(import.meta.glob('@components/posts/*.astro')).map(p => p.split('/').pop().replace('.astro', '')))
  const kitNames = new Set(Object.keys(import.meta.glob('@components/posts/*/index.astro')).map(p => p.split('/').at(-2)))
  const haveLayout = new Set([...flatNames, ...kitNames])
  const pages = scanPages({ withJson: true })
  const groups = buildGroups(pages)
  const bySlug = new Map(pages.map(p => [p.slug, p]))
  const out = []
  for (const lang of langDirs()) {
    const dir = join(process.cwd(), 'content', lang, 'posts')
    if (!existsSync(dir)) continue // 该语言还没有此类型镜像
    for (const f of readdirSync(dir)) {
      if (!f.endsWith('.json')) continue
      const name = f.replace('.json', '')
      const j = JSON.parse(readFileSync(join(dir, f), 'utf8'))
      // 与 zh 路由同口径：同名布局组件 或 模板套件 任一存在才出页（套件兜底，对称性修复）
      if (!flatNames.has(name) && !kitNames.has(j.page.template)) continue
      const params = { lang, slug: name }
      if (process.env.INCLUDE_DRAFTS === '1') { out.push({ params, props: { j } }); continue } // 预览=镜像全文
      const me = bySlug.get(j.page.slug)
      if (!me) throw new Error(`镜像 slug 在族谱未登记（page.slug 与文件位置矛盾=数据损坏）：content/${lang}/posts/${f} 声明 ${j.page.slug}`) // 评审 M8：Chrome 侧同情形 throw，路由不静默跳页
      const pj = productionJson(me, groups, pages) // 生产=approved 投影（null=不出页）
      if (pj) out.push({ params, props: { j: pj } })
    }
  }
  return out
}

const { j } = Astro.props
const slug = Astro.params.slug
// 派发同 zh：数据声明 template 的套件优先 → 同名套件（镜像 JSON 的 template 仍是旧路径式）→ 扁平回退
// glob 键后缀化（zh 路由同款）：查表用 posts/<名>/…，不数 ../../../
const bySuffix = o => Object.fromEntries(Object.entries(o).map(([k, v]) => [k.slice(k.indexOf('/posts/') + 1), v]))
const kitLayouts = bySuffix(import.meta.glob('@components/posts/*/index.astro'))
const flatLayouts = bySuffix(import.meta.glob('@components/posts/*.astro'))
const kit = kitLayouts[`posts/${j.page.template}/index.astro`]
  ?? kitLayouts[`posts/${slug}/index.astro`]
const Comp = kit ? (await kit()).default : (await flatLayouts[`posts/${slug}.astro`]()).default
---
<Chrome j={j}>
	<Comp j={j} />
</Chrome>
