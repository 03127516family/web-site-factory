---
// 产品页路由：content/products/*.json 每份数据出一个页（数据驱动路由）。
// 模版由数据声明：page.template → components/products/<名>/index.astro（glob 派发）。
import Chrome from '@layouts/Chrome.astro'
import { loadPageRecords } from '@src/content/source.mjs'

export function getStaticPaths() {
  return loadPageRecords(process.cwd(), { type: 'products', includeDrafts: process.env.INCLUDE_DRAFTS === '1' })
    .map(({ params, j }) => ({ params, props: { j } }))
}

const { j } = Astro.props
// glob 键后缀化（posts 路由同款）：查表用 products/<名>/index.astro，不数 ../../../
const bySuffix = o => Object.fromEntries(Object.entries(o).map(([k, v]) => [k.slice(k.indexOf('/products/') + 1), v]))
const layouts = bySuffix(import.meta.glob('@components/products/*/index.astro'))
const Comp = (await layouts[`products/${j.page.template}/index.astro`]()).default
---
<Chrome j={j}>
  <Comp j={j} />
</Chrome>
