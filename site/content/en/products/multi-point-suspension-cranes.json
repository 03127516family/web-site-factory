  "summary_intro": {
    "title": "Introduction",
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "The multi-point suspension crane is a specialized suspended crane designed to meet the needs of large-span industrial workshops and warehouses (such as aircraft manufacturing plants and aircraft maintenance plants).",
              "marks": [
                {
                  "type": "span",
                  "attrs": {
                    "class": "i18n-pending"
                  }
                }
              ]
            },
            {
              "type": "text",
              "text": " "
            },
            {
              "type": "text",
              "text": "By distributing the load through multiple suspension points, this crane reduces the impact of the crane's weight on the building's roof structure, thereby lowering the building height and helping to significantly reduce factory construction costs.",
              "marks": [
                {
                  "type": "span",
                  "attrs": {
                    "class": "i18n-pending"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "overview": {
    "title": "Features and Highlights",
    "body": {
      "type": "doc",
      "content": [
        {
          "type": "bulletList",
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The multi-point suspension design makes this crane suitable for large-span workshops, providing a wide working range while effectively reducing structural dimensions, minimizing headroom occupation, and increasing the effective lifting height.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The lightweight crane structure significantly reduces the load requirements on the building roof and steel structure frame.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The articulated connections between multiple spans effectively prevent wheel unloading and excessive load concentration on individual suspension points.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The crane wheel assembly can be adapted to H-beam or I-beam rails, flexibly meeting different building structures and customer needs.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The compact cable festoon system for trolley power supply reduces the limit switches on the left and right ends, thereby improving the overall utilization of workshop space.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Equipped with a three-in-one drive unit and variable frequency drive (VFD) control, it operates smoothly and reliably, with a wide speed adjustment range and high positioning accuracy.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Synchronous control technology ensures coordinated operation of multiple drive units, effectively preventing rail skewing.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The PLC control system enables collaborative operation of multiple cranes, expanding the working range.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The traveling wheels made of wear-resistant engineering plastic help prevent wear on the wheels and crane rails.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "High-strength, oil-free wire ropes and T-grade high-strength hooks improve overall safety and reliability.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The rope guide made of high-performance polymer composite material has the advantages of low wear, high strength, and good toughness.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The electronic anti-sway function improves lifting stability and operational efficiency.",
                      "marks": [
                        {
                          "type": "span",
                          "attrs": {
                            "class": "i18n-pending"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
