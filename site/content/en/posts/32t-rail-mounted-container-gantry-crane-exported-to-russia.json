            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Anti-wind system",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Wind-speed sensors are integrated with a rail-clamping system; when wind speed exceeds the safe limit, it automatically alarms and locks onto the rail to prevent slippage."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Electrical protection system",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ": Includes over-current, over-temperature, phase-loss, phase-sequence-error, under-voltage, and grounding protection to reduce the risk of electrical faults."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  },
