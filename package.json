{
  "name": "dgcrane-placement-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs && python3 -m http.server --directory dist 8080",
    "edit": "node scripts/edit-server.mjs",
    "verify:geom": "node --experimental-websocket scripts/verify-geom.mjs",
    "edit:probe": "node scripts/edit-probe.mjs",
    "i18n:status": "node scripts/i18n-status.mjs",
    "i18n:touch": "node scripts/i18n-touch.mjs",
    "i18n:apply": "node scripts/i18n-apply.mjs",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "check": "node --test scripts/ && npm run edit:probe && npm run verify:geom",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "node-html-parser": "^8.0.3",
    "yaml": "^2.9.0"
  }
}
